{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jerseys",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "OWNER_COOKIE_DOMAIN": "nicolastemeni.workers.dev" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jerseys",
			"database_id": "4d824f55-f2ea-4107-9b7b-e37d362b61cb",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "COVERS",
			"bucket_name": "jerseys-covers"
		}
	],
	"secrets": {
		"required": ["OWNER_PASSWORD", "JWT_SECRET", "THESPORTSDB_KEY"]
	}
}
