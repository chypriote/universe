---
import Container from '@/components/Container.astro';
import type { TripArchiveEntry } from '@/lib/itineraries.server';

interface Props {
  trips: TripArchiveEntry[];
}

const { trips } = Astro.props;
---

<section id="completed-trips" class="snap-start py-24 lg:py-32">
  <Container>
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 lg:mb-24 pb-8 bamboo-b reveal">
      <div class="flex items-end gap-6 lg:gap-8">
        <span lang="zh" class="vertical font-brush text-5xl lg:text-6xl leading-none" aria-hidden="true">游记</span>
        <div>
          <span class="eyebrow">Trip reports</span>
          <h2 class="mt-4 text-h2 font-serif font-light">Recent journeys</h2>
        </div>
      </div>
      <a href="/trips" class="eyebrow text-foreground hover:text-primary transition-colors">All journeys →</a>
    </header>

    <div class="flex flex-col gap-24 lg:gap-32">
      {trips.map((trip, index) => {
        const imageLeft = index % 2 === 0;
        const cover = trip.photos[0];

        return (
          <article class="group grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
            {cover && (
              <div class:list={['lg:col-span-7 bamboo-frame', imageLeft ? 'reveal-left' : 'lg:order-2 reveal-right']}>
                <a href={trip.link} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
                  <img
                    src={cover}
                    alt=""
                    class="w-full aspect-[3/2] object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </a>
              </div>
            )}
            <div class:list={['lg:col-span-5 flex flex-col gap-5 reveal reveal-delay-1', !imageLeft && 'lg:order-1']}>
              <div class="flex items-baseline gap-4">
                <span class="font-serif text-5xl font-light text-gold-ink">{String(index + 1).padStart(2, '0')}</span>
                <span class="eyebrow text-muted-foreground">{trip.dates}</span>
              </div>
              <h3 class="text-3xl lg:text-4xl font-serif font-normal">
                <a href={trip.link} class="hover:text-primary transition-colors">{trip.title}</a>
              </h3>
              <p class="text-muted-foreground leading-relaxed">{trip.description}</p>
              {trip.regions.length > 0 && (
                <p class="eyebrow text-muted-foreground">{trip.regions.join(' · ')}</p>
              )}
              <a href={trip.link} class="group/link inline-flex items-center gap-3 eyebrow w-fit">
                Read the journal
                <span class="transition-transform group-hover/link:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </Container>
</section>
