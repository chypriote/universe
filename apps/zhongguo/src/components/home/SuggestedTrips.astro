---
import Container from '@/components/Container.astro';
import Panda from '@/components/Panda.astro';
import SectionHeader from '@/components/home/SectionHeader.astro';
import type { TripArchiveEntry } from '@/lib/itineraries.server';

interface Props {
  trips: TripArchiveEntry[];
}

const { trips } = Astro.props;
---

<section id="suggested-trips" class="snap-section py-12 lg:py-10 bamboo-t after:right-auto after:left-[4%] after:-scale-x-100">
  <Panda class="absolute right-[22px] top-1/2 -translate-y-1/2 z-[1] w-20 hidden min-[1400px]:block" />
  <Container>
    <header class="mb-10 reveal">
      <SectionHeader zh="行程" eyebrow="Itineraries" title="Next on the list" lead="Where I'm heading next, and how I'll get there." />
    </header>

    {trips.length === 0 ? (
      <p class="text-muted-foreground font-serif">No trip plans yet.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {trips.map((trip, index) => {
          const cover = trip.photos[0];

          return (
            <article class={`group flex flex-col reveal reveal-delay-${Math.min(index + 1, 5)}`}>
              <a href={trip.link} class="block overflow-hidden mb-5" tabindex="-1" aria-hidden="true">
                {cover ? (
                  <img
                    src={cover}
                    alt=""
                    class="w-full aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                ) : (
                  <div class="aspect-[4/3] bg-background border border-border grid place-items-center">
                    <span class="seal w-16 text-3xl">中</span>
                  </div>
                )}
              </a>
              <span class="eyebrow text-muted-foreground">{trip.durationDays ? `${trip.durationDays} days · ` : ''}{trip.dates}</span>
              <h3 class="mt-3 text-2xl font-serif">
                <a href={trip.link} class="hover:text-primary transition-colors">{trip.title}</a>
              </h3>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed line-clamp-3">{trip.description}</p>
            </article>
          );
        })}
      </div>
    )}
  </Container>
</section>
