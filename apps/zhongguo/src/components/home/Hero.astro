---
import InkWash from '@/components/InkWash.astro';
import TempleGate from '@/components/TempleGate.astro';
---

<section class="h-[88svh] min-h-[600px] bamboo-b">
  <div class="absolute inset-0 overflow-hidden">
    <InkWash plum={false} birds={false} class="absolute inset-0 w-full h-full text-foreground opacity-60 md:opacity-100" />
  </div>
  <div class="absolute right-[9%] bottom-[16%] w-52 lg:w-80 text-foreground/70 hidden md:block">
    <TempleGate>
      <span slot="plaque" lang="zh" class="font-brush text-gold text-[0.65rem] lg:text-sm leading-none whitespace-nowrap">游记</span>
    </TempleGate>
  </div>

  <div class="relative z-10 h-full flex flex-col items-center pt-[14vh] px-4 text-center">
    <p class="eyebrow tracking-[0.6em] hero-animate">A journal of China</p>
    <h1 class="mt-8 hero-animate hero-animate-delay-1">
      <span class="relative inline-block">
        <span lang="zh" class="block font-brush text-[clamp(4rem,2rem+9vw,10rem)] leading-none tracking-[0.05em]">中国游记</span>
        <span lang="zh" class="seal absolute -right-6 lg:-right-12 -bottom-2 w-7 lg:w-10 text-xs lg:text-base" aria-hidden="true">中</span>
      </span>
      <span class="mt-6 block font-serif uppercase font-light tracking-[0.35em] text-sm lg:text-base text-gold-ink">China, trip by trip</span>
    </h1>
    <div class="mt-10 flex flex-wrap justify-center gap-4 hero-animate hero-animate-delay-2">
      <a href="/trips" class="btn bg-foreground text-background hover:bg-foreground/85">Read the journeys</a>
      <a href="/planner" class="btn btn-outline">Flight planner</a>
    </div>
  </div>

  <span class="absolute left-1/2 bottom-8 z-10 h-16 w-px bg-foreground/50 hero-animate hero-animate-delay-3" aria-hidden="true"></span>
</section>
