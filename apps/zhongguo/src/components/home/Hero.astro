---
import InkWash from '@/components/InkWash.astro';
---

<section class="snap-section h-[calc(100svh-var(--nav-height))] min-h-[600px] bamboo-b after:right-auto after:left-[4%] after:-scale-x-100">
  <div class="absolute inset-0 overflow-hidden">
    <InkWash
      plum={false}
      birds={false}
      class="absolute inset-0 w-full h-full text-foreground opacity-60 md:opacity-100"
    />
  </div>

  <div class="relative z-10 h-full flex flex-col items-center pt-[14vh] px-4 text-center">
    <h1 class="hero-animate hero-animate-delay-1">
      <span class="relative inline-block">
        <span
          lang="zh"
          class="block font-brush text-[clamp(4rem,2rem+9vw,10rem)] leading-none tracking-[0.05em]"
        >
          中国游记
        </span>
        <span
          lang="zh"
          class="seal absolute -right-6 lg:-right-12 -bottom-2 w-7 lg:w-10 text-xs lg:text-base"
          aria-hidden="true"
        >
          中
        </span>
      </span>
      <span class="mt-6 block font-serif uppercase font-light tracking-[0.35em] text-sm lg:text-base text-gold-ink">
        China Travel Memories
      </span>
    </h1>
    <div class="mt-10 flex flex-wrap justify-center gap-4 hero-animate hero-animate-delay-2">
      <a href="/trips" class="btn bg-foreground text-background hover:bg-foreground/85">
        Read the journeys
      </a>
      <a href="/planner" class="btn btn-outline">
        Plan a trip
      </a>
    </div>
  </div>

  <span
    class="absolute left-1/2 bottom-8 z-10 h-16 w-px bg-foreground/50 hero-animate hero-animate-delay-3"
    aria-hidden="true"
  ></span>
</section>
