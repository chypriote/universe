---
import { Image } from 'astro:assets';
import Container from '@/components/Container.astro';
import heroImage from '@/assets/hero.jpg';
---

<section class="relative h-[88svh] min-h-[560px] overflow-hidden bg-dark-background text-white">
  <Image
    src={heroImage}
    alt="A pyramid of prayer flags beside Qinghai Lake, with snow mountains behind"
    widths={[900, 1400, 2000, 2800]}
    sizes="100vw"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-black/45"></div>

  <p
    lang="zh"
    class="absolute bottom-6 left-4 lg:bottom-auto lg:left-auto lg:right-10 lg:top-10 flex flex-row lg:flex-col items-center gap-2 lg:gap-3 bg-primary text-gold outline outline-1 -outline-offset-4 outline-gold/60 px-5 py-3.5 lg:px-5 lg:py-7 text-3xl lg:text-5xl font-bold leading-none hero-animate hero-animate-delay-3"
    aria-hidden="true"
  >
    {[...'中国游记'].map((char) => <span>{char}</span>)}
  </p>

  <Container class="relative z-10 h-full flex flex-col items-center justify-center text-center">
    <h1 class="max-w-4xl text-h1 font-display tracking-tight hero-animate hero-animate-delay-1">
      China, trip by trip: photographs, itineraries and flight prices.
    </h1>
    <div class="mt-10 flex flex-wrap justify-center gap-4 hero-animate hero-animate-delay-2">
      <a href="/trips" class="btn bg-white text-dark-background hover:bg-white/85">Read the journeys</a>
      <a href="/planner" class="btn btn-outline text-white hover:!bg-white hover:!border-white hover:!text-dark-background">Flight planner</a>
    </div>
  </Container>
</section>
