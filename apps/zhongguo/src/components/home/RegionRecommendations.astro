---
import Container from '@/components/Container.astro';
import SectionHeader from '@/components/home/SectionHeader.astro';
import { ChinaMap, type ChinaMapRegion } from '@/components/islands/ChinaMap';
import { getRegionZh } from '@/lib/china-map';
import type { GalleryPhoto, TripArchiveEntry } from '@/lib/itineraries.server';

interface Props {
  trips: TripArchiveEntry[];
  photos: GalleryPhoto[];
}

const { trips, photos } = Astro.props;

const byRegion = new Map<string, ChinaMapRegion>();
const tripCount = new Map<string, number>();
// Only past journeys count: a plan's provinces are not visited yet.
for (const trip of trips.filter((trip) => trip.type === 'report')) {
  for (const name of trip.regions) {
    const count = (tripCount.get(name) ?? 0) + 1;
    tripCount.set(name, count);
    const entry = byRegion.get(name) ?? { name, zh: getRegionZh(name), href: trip.link };
    entry.photo ??= (
      photos.find((photo) => photo.region === name && photo.cover) ?? photos.find((photo) => photo.region === name)
    )?.thumb;
    entry.detail = `${count} ${count === 1 ? 'trip' : 'trips'}`;
    byRegion.set(name, entry);
  }
}
const regions = [...byRegion.values()];
---

{regions.length > 0 && (
  <section id="region-recommendations" class="snap-section py-12 lg:py-10 bamboo-t after:right-auto after:left-[4%] after:-scale-x-100">
    <Container>
      <SectionHeader class="mb-6" zh="山河" eyebrow="Mountains and rivers" title="Provinces" lead="Every province I have visited, each linked to its trip." />
      <ChinaMap client:visible regions={regions} idleText="Hover a province" />
    </Container>
  </section>
)}
