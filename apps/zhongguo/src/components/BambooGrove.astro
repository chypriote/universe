---
// Gold bamboo stalks from the top of the page down to the footer, on the right edge. Their tops are cut at a node, as in ink paintings.
// Stalks and leaf sprays are SVG patterns, so they repeat for any page height. Colour is currentColor.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// x and width in px from the left of the 160px strip; node = distance between nodes;
// top = where the stalk is cut, minus 60px, so the tops do not end on one line.
const stalks = [
  { x: 62, width: 13, node: 124, offset: 30, top: 50 },
  { x: 86, width: 11, node: 108, offset: 0, top: 0 },
  { x: 106, width: 16, node: 136, offset: 70, top: 30 },
  { x: 132, width: 12, node: 116, offset: 15, top: 80 },
];
const tip = 90;

const width = 160;
const dark = 'color-mix(in srgb, currentColor 72%, black)';
const light = 'color-mix(in srgb, currentColor 80%, white)';

// One leaf: a narrow blade from (0,0) along +x, length l, width w.
const leaf = (l: number, w: number) =>
  `M0,0 Q${l * 0.35},${-w} ${l},0 Q${l * 0.35},${w * 0.5} 0,0Z`;

// A spray: leaves fanning from a node, pointing left or right and drooping.
function spray(cx: number, cy: number, dir: 1 | -1, seed: number) {
  const leaves = [];
  const count = 4 + (seed % 2);
  for (let i = 0; i < count; i++) {
    const angle = dir === 1 ? 8 + i * 14 + (seed % 7) : 172 - i * 14 - (seed % 7);
    const length = (dir === 1 ? 54 : 46) + ((seed * (i + 3)) % 22);
    leaves.push({ d: leaf(length, 5 + (i % 2)), transform: `translate(${cx} ${cy}) rotate(${angle})`, fill: i % 2 ? dark : 'currentColor' });
  }
  return leaves;
}

// Crown: two full sprays below each cut top.
const crown = stalks.flatMap((stalk, i) => {
  const cx = stalk.x + 2 + stalk.width / 2;
  const base = stalk.top + tip;
  return [
    ...spray(cx, base - 10, i % 2 ? 1 : -1, i + 2),
    ...spray(cx, base + 40, i % 2 ? -1 : 1, i + 6),
  ];
});

const leafPeriod = 1400;
// Three sprays per stalk in each period, staggered between stalks.
const sprays = stalks.flatMap((stalk, i) =>
  [0, 1, 2].flatMap((k) =>
    spray(stalk.x + stalk.width / 2, 120 + k * 420 + i * 105, (i + k) % 2 ? 1 : -1, i * 3 + k + 3),
  ),
);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height="100%"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <defs>
    {stalks.map((stalk, i) => (
      <pattern id={`bamboo-stalk-${i}`} patternUnits="userSpaceOnUse" x={stalk.x} y={stalk.offset} width={stalk.width + 4} height={stalk.node}>
        <rect x="2" y="0" width={stalk.width} height={stalk.node} style={`fill:${i % 2 ? dark : 'currentColor'}`} />
        <rect x={2 + stalk.width * 0.22} y="4" width="1.4" height={stalk.node - 8} style={`fill:${light}`} opacity="0.9" />
        <rect x="0" y={stalk.node - 2.2} width={stalk.width + 4} height="2.2" style={`fill:${dark}`} />
        <rect x="2" y={stalk.node - 5} width={stalk.width} height="1" style={`fill:${light}`} opacity="0.6" />
      </pattern>
    ))}
    <pattern id="bamboo-leaves" patternUnits="userSpaceOnUse" x="0" y="0" width={width} height={leafPeriod}>
      {sprays.map((l) => <path d={l.d} transform={l.transform} style={`fill:${l.fill}`} />)}
    </pattern>
  </defs>
  {stalks.map((stalk, i) => (
    <>
      <rect x={stalk.x + 2} y={stalk.top + tip - 30} width={stalk.width} height="32" style={`fill:${i % 2 ? dark : 'currentColor'}`} />
      <ellipse cx={stalk.x + 2 + stalk.width / 2} cy={stalk.top + tip - 30} rx={stalk.width / 2} ry="2.6" style={`fill:${dark}`} />
      <ellipse cx={stalk.x + 2 + stalk.width / 2} cy={stalk.top + tip - 30} rx={stalk.width / 2 - 2} ry="1.4" style={`fill:${light}`} />
      <rect x={stalk.x} y={stalk.top + tip - 4} width={stalk.width + 4} height="2.2" style={`fill:${dark}`} />
      <rect x={stalk.x} y={stalk.top + tip} width={stalk.width + 4} height="100%" fill={`url(#bamboo-stalk-${i})`} />
    </>
  ))}
  <rect x="0" y="260" width={width} height="100%" fill="url(#bamboo-leaves)" />
  {crown.map((l) => <path d={l.d} transform={l.transform} style={`fill:${l.fill}`} />)}
</svg>
