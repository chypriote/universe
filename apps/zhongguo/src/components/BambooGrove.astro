---
import { stalks, spray, sprayAnchors, leafPeriod, dark } from './groveGeometry';
// Gold bamboo stalks from the top of the page down to the footer, on the right edge. Their tops are cut at a node, as in ink paintings.
// Stalks and leaf sprays are SVG patterns, so they repeat for any page height. Colour is currentColor.
interface Props {
  class?: string;
  // Only extra leaf sprays on the grove's stalks, to make the grove fuller where it is drawn (the footer).
  leavesOnly?: boolean;
}

const { class: className, leavesOnly = false } = Astro.props;

const tip = 90;

const width = 160;
const light = 'color-mix(in srgb, currentColor 80%, white)';

// Crown: two full sprays below each cut top.
const crown = stalks.flatMap((stalk, i) => {
  const cx = stalk.x + 2 + stalk.width / 2;
  const base = stalk.top + tip;
  return [
    ...spray(cx, base - 10, i % 2 ? 1 : -1, i + 2),
    ...spray(cx, base + 40, i % 2 ? -1 : 1, i + 6),
  ];
});

const sprays = sprayAnchors.flatMap(({ cx, cy, dir, seed }) => spray(cx, cy, dir, seed));

const denseLeafPeriod = 520;
const denseSprays = stalks.flatMap((stalk, i) =>
  spray(stalk.x + 2 + stalk.width / 2, 60 + i * 130, i % 2 ? 1 : -1, i * 5 + 4),
);
---

{leavesOnly ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={width}
    height="100%"
    fill="currentColor"
    aria-hidden="true"
    class={className}
  >
    <defs>
      <pattern
        id="bamboo-leaves-dense"
        patternUnits="userSpaceOnUse"
        x="0"
        y="0"
        width={width}
        height={denseLeafPeriod}
      >
        {denseSprays.map((l) => (
          <path d={l.d} transform={l.transform} style={`fill:${l.fill}`} />
        ))}
      </pattern>
    </defs>
    <rect x="0" y="0" width={width} height="100%" fill="url(#bamboo-leaves-dense)" />
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={width}
    height="100%"
    fill="currentColor"
    aria-hidden="true"
    class={className}
  >
    <defs>
      {stalks.map((stalk, i) => (
        <pattern
          id={`bamboo-stalk-${i}`}
          patternUnits="userSpaceOnUse"
          x={stalk.x}
          y={stalk.offset}
          width={stalk.width + 4}
          height={stalk.node}
        >
          <rect
            x="2"
            y="0"
            width={stalk.width}
            height={stalk.node}
            style={`fill:${i % 2 ? dark : 'currentColor'}`}
          />
          <rect
            x={2 + stalk.width * 0.22}
            y="4"
            width="1.4"
            height={stalk.node - 8}
            style={`fill:${light}`}
            opacity="0.9"
          />
          <rect
            x="0"
            y={stalk.node - 2.2}
            width={stalk.width + 4}
            height="2.2"
            style={`fill:${dark}`}
          />
          <rect
            x="2"
            y={stalk.node - 5}
            width={stalk.width}
            height="1"
            style={`fill:${light}`}
            opacity="0.6"
          />
        </pattern>
      ))}
      <pattern
        id="bamboo-leaves"
        patternUnits="userSpaceOnUse"
        x="0"
        y="0"
        width={width}
        height={leafPeriod}
      >
        {sprays.map((l) => (
          <path d={l.d} transform={l.transform} style={`fill:${l.fill}`} />
        ))}
      </pattern>
    </defs>
    {stalks.map((stalk, i) => (
      <>
        <rect
          x={stalk.x + 2}
          y={stalk.top + tip - 30}
          width={stalk.width}
          height="32"
          style={`fill:${i % 2 ? dark : 'currentColor'}`}
        />
        <ellipse
          cx={stalk.x + 2 + stalk.width / 2}
          cy={stalk.top + tip - 30}
          rx={stalk.width / 2}
          ry="2.6"
          style={`fill:${dark}`}
        />
        <ellipse
          cx={stalk.x + 2 + stalk.width / 2}
          cy={stalk.top + tip - 30}
          rx={stalk.width / 2 - 2}
          ry="1.4"
          style={`fill:${light}`}
        />
        <rect
          x={stalk.x}
          y={stalk.top + tip - 4}
          width={stalk.width + 4}
          height="2.2"
          style={`fill:${dark}`}
        />
        <rect
          x={stalk.x}
          y={stalk.top + tip}
          width={stalk.width + 4}
          height="100%"
          fill={`url(#bamboo-stalk-${i})`}
        />
      </>
    ))}
    <rect x="0" y="260" width={width} height="100%" fill="url(#bamboo-leaves)" />
    {crown.map((l) => (
      <path d={l.d} transform={l.transform} style={`fill:${l.fill}`} />
    ))}
  </svg>
)}
