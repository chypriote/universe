---
import InkWash from '@/components/InkWash.astro';

// Page header of the index pages: a short version of the home hero. Ink wash, the page name in brush
// calligraphy with the 中 seal, the English title in gold serif caps, and a lead.
interface Props {
  /** Brush calligraphy above the title. Add new characters to the font subset (DESIGN.md). */
  zh: string;
  title: string;
}
const { zh, title } = Astro.props;
---

<header class="bamboo-b">
  <div class="absolute inset-0 overflow-hidden">
    <InkWash
      plum={false}
      birds={false}
      class="absolute inset-0 w-full h-full text-foreground opacity-60 md:opacity-100"
    />
  </div>
  <div class="relative z-10 flex flex-col items-center px-4 pt-14 pb-24 lg:pt-20 lg:pb-32 text-center">
    <h1>
      <span class="relative inline-block">
        <span
          lang="zh"
          class="block font-brush text-[clamp(3.5rem,2rem+5vw,6.5rem)] leading-none tracking-[0.05em]"
          aria-hidden="true"
        >
          {zh}
        </span>
        <span
          lang="zh"
          class="seal absolute -right-6 lg:-right-10 -bottom-1 w-6 lg:w-8 text-[0.65rem] lg:text-sm"
          aria-hidden="true"
        >
          中
        </span>
      </span>
      <span class="mt-5 block font-serif uppercase font-light tracking-[0.35em] text-sm lg:text-base text-gold-ink">
        {title}
      </span>
    </h1>
    <p class="mt-5 text-lg text-muted-foreground leading-relaxed max-w-xl">
      <slot />
    </p>
  </div>
</header>

<style is:global>
  /* The bamboo tops end inside the header, half in mist, as on the home page. */
  #bamboo-grove {
    top: calc(var(--nav-height) + 6rem);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.3), black 360px);
  }
</style>
