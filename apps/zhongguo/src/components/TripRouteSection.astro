---
import Container from '@/components/Container.astro';
import TripRegionsMap from '@/components/TripRegionsMap.astro';
import type { Route } from '@/lib/journal';

interface Props {
  route: Route;
  regions: string[];
}

const { route, regions } = Astro.props;
---

{route.stops.length > 0 && (
  <section class="snap-start bamboo-b py-20 lg:py-28">
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <TripRegionsMap route={route} regions={regions} aspect={1.2} class="lg:col-span-7" />
        <div class="space-y-6 lg:col-span-5 xl:pr-16">
          <span class="eyebrow">The route</span>
          <ol class="space-y-4 border-l border-gold-ink/50 pl-6">
            {route.stops.map((stop) => (
              <li class="route-stop relative" data-route-city={stop.name}>
                <span class="absolute -left-[1.85rem] top-2 h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
                <a href={`#day-${stop.days[0]}`} class="flex items-baseline gap-3 transition-colors hover:text-primary">
                  <span class="font-serif text-xl">{stop.name}</span>
                  <span lang="zh" class="text-sm text-muted-foreground">{stop.nameZh}</span>
                  <span class="ml-auto eyebrow text-[0.625rem] text-muted-foreground">{stop.dayLabel}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Container>
  </section>
)}

<script>
  // Hovering a city in the list or its pin on the map lights up the other.
  const sections = document.querySelectorAll('section:has([data-route-city])');
  for (const section of sections) {
    const items = section.querySelectorAll<HTMLElement>('[data-route-city]');
    const light = (city: string | null) => {
      for (const item of items) item.toggleAttribute('data-active', item.dataset.routeCity === city);
    };
    for (const item of items) {
      item.addEventListener('mouseenter', () => light(item.dataset.routeCity ?? null));
      item.addEventListener('mouseleave', () => light(null));
    }
  }
</script>

<style is:global>
  .route-dot {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.15s;
  }
  .route-name {
    opacity: 0;
    transition: opacity 0.15s;
    paint-order: stroke;
    stroke: var(--color-background);
    stroke-width: 3px;
  }
  .route-pin[data-active] .route-dot {
    transform: scale(2.2);
  }
  .route-pin[data-active] .route-name {
    opacity: 1;
  }
  .route-stop[data-active] {
    color: var(--color-primary);
  }
  .route-stop[data-active] > a > span:first-of-type {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
