---
// A waving panda, drawn in black-and-white outline style. Keep to the shape
// rules in DESIGN.md ("Panda drawing") when changing it.
// The raised paw (x ≈ 10 of 80 when w-20, or 70 with `mirror`) holds a grove stalk.
interface Props {
  class?: string;
  dark?: boolean;
  mirror?: boolean;
}
const { class: className, dark, mirror } = Astro.props;
const body =
  'M66,205 C52,250 58,322 112,331 C162,339 208,318 212,268 C215,228 200,196 176,188 C140,178 88,184 66,205Z';
const clipId = dark ? 'panda-body-dark' : 'panda-body';
const white = 'fill:var(--color-background)';
const line = 'stroke:var(--color-foreground)';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 318 360"
  aria-hidden="true"
  class:list={[dark ? 'text-[hsl(45_10%_3%)]' : 'text-foreground', className]}
>
  <defs>
    <clipPath id={clipId}>
      <path d={body} />
    </clipPath>
  </defs>
  <g transform={mirror ? 'translate(318 0) scale(-1 1)' : undefined}>
    <g fill="currentColor">
      <path d="M80,280 C72,320 76,352 102,354 C126,356 131,330 127,292Z" />
      <path d="M156,292 C152,330 156,354 180,354 C204,354 206,326 200,284Z" />
      <path d={body} />
    </g>
    <path
      d="M56,236 C96,206 170,226 214,300 L214,345 L50,345Z"
      style={white}
      clip-path={`url(#${clipId})`}
    />
    <path d={body} fill="none" style={line} stroke-width="6" />
    <g fill="currentColor">
      <path d="M166,190 C210,196 248,230 260,274 C268,306 238,318 222,298 C208,278 194,260 170,246Z" />
      <path d="M28,122 C18,102 36,86 54,96 C82,112 112,150 128,192 C118,222 84,224 66,206 C50,184 38,152 28,122Z" />
      <circle cx="122" cy="44" r="30" />
      <circle cx="262" cy="98" r="26" />
    </g>
    <ellipse
      cx="172"
      cy="122"
      rx="92"
      ry="78"
      transform="rotate(14 172 122)"
      style={`${white};${line}`}
      stroke-width="6"
    />
    <g style="fill:var(--color-foreground)">
      <ellipse cx="124" cy="110" rx="27" ry="18" transform="rotate(-22 124 110)" />
      <ellipse cx="212" cy="142" rx="19" ry="27" transform="rotate(-28 212 142)" />
      <path d="M150,130 Q160,124 170,130 Q168,140 160,141 Q152,140 150,130Z" />
    </g>
    <g style={white}>
      <ellipse cx="128" cy="103" rx="7" ry="5" transform="rotate(-20 128 103)" />
      <ellipse cx="215" cy="133" rx="5" ry="7" transform="rotate(-20 215 133)" />
    </g>
    <path
      d="M160,141 V148 M143,148 Q151,159 160,148 Q169,159 178,148"
      fill="none"
      style={line}
      stroke-width="4"
      stroke-linecap="round"
    />
  </g>
</svg>
