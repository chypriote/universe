---
// A small round panda hugging a bamboo stalk. The stalk is not drawn:
// place the panda so its paws (x = 62 in the viewBox) sit on a stalk.
interface Props {
  class?: string;
  dark?: boolean;
}
const { class: className, dark } = Astro.props;
// On a dark ground the black fur gets a thin paper edge so it stays visible.
const fur = dark ? 'stroke:var(--color-background);stroke-width:1' : '';
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 100" aria-hidden="true" class:list={['text-foreground', className]}>
  <g fill="currentColor" style={fur}>
    <circle cx="14" cy="13" r="7.5" />
    <circle cx="54" cy="12" r="7.5" />
  </g>
  <ellipse cx="34" cy="70" rx="23" ry="22" fill="var(--color-background)" stroke="currentColor" stroke-width="2" />
  <g fill="currentColor" style={fur}>
    <ellipse cx="19" cy="88" rx="11" ry="8" transform="rotate(-10 19 88)" />
    <ellipse cx="52" cy="86" rx="11" ry="7" transform="rotate(-25 52 86)" />
  </g>
  <g stroke="currentColor" stroke-linecap="round" fill="none">
    <path d="M47 54 Q56 54 62 60" stroke-width="12" />
    <path d="M20 58 Q36 72 62 70" stroke-width="11" />
  </g>
  <ellipse cx="34" cy="31" rx="24" ry="21" fill="var(--color-background)" stroke="currentColor" stroke-width="2" />
  <g fill="currentColor">
    <ellipse cx="24.5" cy="32" rx="5.6" ry="7.2" transform="rotate(30 24.5 32)" />
    <ellipse cx="43.5" cy="32" rx="5.6" ry="7.2" transform="rotate(-30 43.5 32)" />
    <ellipse cx="34" cy="39" rx="2.8" ry="2" />
  </g>
  <g fill="var(--color-background)">
    <circle cx="25.5" cy="30.5" r="2.2" />
    <circle cx="42.5" cy="30.5" r="2.2" />
  </g>
  <g fill="currentColor">
    <circle cx="25.8" cy="30.8" r="1.1" />
    <circle cx="42.2" cy="30.8" r="1.1" />
  </g>
  <path d="M30.5 42.5 Q34 46 37.5 42.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
</svg>
