---
import { ArrowUp } from '@lucide/astro';
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="fixed bottom-4 right-4 md:bottom-8 md:right-8 z-30 hidden h-12 w-12 items-center justify-center bg-primary text-primary-foreground transition-colors hover:bg-primary-hover"
>
  <ArrowUp size={20} aria-hidden="true" />
</button>

<script>
  const button = document.getElementById('back-to-top');
  if (button) {
    // Hide the button while it would cover gallery controls (phones put them under it).
    const coversControls = () => {
      const top = window.innerHeight - 80;
      return [...document.querySelectorAll('[data-covers-back-to-top]')].some((el) => {
        const r = el.getBoundingClientRect();
        return r.bottom > top && r.top < window.innerHeight && r.right > window.innerWidth - 80;
      });
    };
    const update = () => {
      const show = window.scrollY >= 600 && !coversControls();
      button.classList.toggle("hidden", !show);
      button.classList.toggle("flex", show);
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
