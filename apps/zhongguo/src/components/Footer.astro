---
import Koala from '@universe/universe/astro/Koala.astro';
import Bamboo from '@/components/Bamboo.astro';
import Panda from '@/components/Panda.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const links = [
  { href: '/trips', label: 'Journeys', zh: '游记' },
  { href: '/guides', label: 'Guides', zh: '指南' },
  { href: '/planner', label: 'Flight planner', zh: '机票' },
  { href: '/gallery', label: 'Photography', zh: '影集' },
];
---

<footer class="bamboo-t pt-20 pb-10 bg-dark-background text-dark-foreground">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Bamboo class="absolute -right-12 -bottom-10 h-[130%] w-auto text-gold-ink hidden md:block" flip />
  </div>
  <Panda dark class="absolute right-[28px] top-24 z-[1] w-16 hidden min-[1400px]:block" />
  <Container class="relative">
    <div class="flex flex-col md:flex-row md:items-center gap-12 pb-16 border-b border-dark-border">
      <span lang="zh" class="vertical font-brush text-5xl lg:text-6xl leading-none" aria-hidden="true">一路平安</span>
      <div class="max-w-md">
        <p class="flex items-center gap-4 font-serif text-3xl md:text-4xl font-light leading-tight">
          <span class="seal w-10 text-xl" aria-hidden="true">中</span>
          <span>Nico to <span lang="zh">中国</span></span>
        </p>
        <p class="mt-4 text-sm text-dark-muted-foreground leading-relaxed">{SITE.description}</p>
      </div>

      <ul class="md:ml-auto md:mr-40 list-none p-0 m-0 flex flex-col">
        {links.map((link) => (
          <li>
            <a href={link.href} class="relative isolate inline-flex items-center min-h-14 pl-13 font-serif text-lg uppercase tracking-[0.14em] text-dark-foreground no-underline hover:text-gold transition-colors">
              <span lang="zh" class="absolute left-0 top-1/2 -translate-y-1/2 -z-10 font-brush text-[3.25rem] leading-none whitespace-nowrap text-gold/15 pointer-events-none" aria-hidden="true">{link.zh}</span>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="pt-8 flex items-center gap-2 text-xs text-dark-muted-foreground">
      <Koala size={16} />
      © {new Date().getFullYear()} {SITE.title}
    </p>
  </Container>
</footer>
