---
import Koala from '@universe/universe/astro/Koala.astro';
import Bamboo from '@/components/Bamboo.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const links = [
  { href: '/trips', label: 'Journeys' },
  { href: '/guides', label: 'Guides' },
  { href: '/planner', label: 'Flight planner' },
  { href: '/gallery', label: 'Photography' },
];
---

<footer class="bamboo-t pt-20 pb-10">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Bamboo class="absolute -right-12 -bottom-10 h-[130%] w-auto text-gold-ink hidden md:block" flip />
  </div>
  <Container class="relative">
    <div class="flex flex-col md:flex-row md:items-center gap-12 pb-16 border-b border-border">
      <div class="max-w-md">
        <p class="font-serif text-3xl md:text-4xl font-light leading-tight">
          Nico to <span lang="zh">中国</span>
        </p>
        <p class="mt-4 text-sm text-muted-foreground leading-relaxed">{SITE.description}</p>
      </div>

      <div class="md:ml-auto md:mr-40 flex items-center gap-12">
        <ul class="list-none p-0 m-0 flex flex-col gap-3">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-foreground no-underline hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <span lang="zh" class="vertical font-brush text-5xl lg:text-6xl leading-none" aria-hidden="true">一路平安</span>
      </div>
    </div>

    <p class="pt-8 flex items-center gap-2 text-xs text-muted-foreground">
      <Koala size={16} />
      © {new Date().getFullYear()} {SITE.title}
    </p>
  </Container>
</footer>
