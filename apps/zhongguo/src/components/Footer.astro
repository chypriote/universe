---
import Koala from '@universe/universe/astro/Koala.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const links = [
  { href: '/trips', label: 'Journeys' },
  { href: '/guides', label: 'Guides' },
  { href: '/planner', label: 'Flight planner' },
  { href: '/gallery', label: 'Photography' },
];
---

<footer class="bg-dark-background text-dark-foreground pt-20 pb-10">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-12 pb-16 border-b border-dark-border">
      <div class="max-w-md">
        <span class="seal w-12 text-2xl mb-8" aria-hidden="true">中</span>
        <p class="font-serif text-3xl md:text-4xl font-light leading-tight">
          Nico to <span lang="zh">中国</span>
        </p>
        <p class="mt-4 text-sm text-dark-muted-foreground leading-relaxed">{SITE.description}</p>
      </div>

      <ul class="list-none p-0 m-0 grid grid-cols-2 gap-x-12 gap-y-3">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-dark-foreground no-underline hover:text-primary transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="pt-8 flex items-center gap-2 text-xs text-dark-muted-foreground">
      <Koala size={16} />
      © {new Date().getFullYear()} {SITE.title}
    </p>
  </Container>
</footer>
