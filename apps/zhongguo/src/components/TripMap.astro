---
import { CHINA_MAP, projectLngLat } from '@/lib/china-map';
import type { Route } from '@/lib/journal';

interface Props {
  route: Route;
}

const { route } = Astro.props;

const ASPECT = 16 / 10;
const MIN_WIDTH = 240;

const project = (stop: { lng: number; lat: number }) => projectLngLat(stop.lng, stop.lat);
const line = route.stops.map(project);
const cities = route.cities.map((city) => ({ ...city, pos: project(city) }));

// Zoom onto the stops: their bounding box plus padding, widened to the frame's aspect ratio.
const xs = line.map(([x]) => x);
const ys = line.map(([, y]) => y);
const spanX = Math.max(...xs) - Math.min(...xs);
const spanY = Math.max(...ys) - Math.min(...ys);
const pad = Math.max(spanX, spanY) * 0.2 + 30;
let width = Math.max(spanX + pad * 2, (spanY + pad * 2) * ASPECT, MIN_WIDTH);
width = Math.min(width, CHINA_MAP.width);
const height = width / ASPECT;
const x0 = (Math.min(...xs) + Math.max(...xs)) / 2 - width / 2;
const y0 = (Math.min(...ys) + Math.max(...ys)) / 2 - height / 2;

const unit = width / 100;
const fontSize = unit * 1.9;
const dotRadius = unit * 0.8;

// A label goes beside its dot, on the first side that clears every other label and dot.
type Box = { x: number; y: number; w: number; h: number };
const overlaps = (a: Box, b: Box) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
const boxes: Box[] = cities.map(({ pos }) => ({
  x: pos[0] - dotRadius,
  y: pos[1] - dotRadius,
  w: dotRadius * 2,
  h: dotRadius * 2,
}));
const labels = cities.map((city) => {
  const w = city.name.length * fontSize * 0.55;
  const gap = dotRadius * 1.8;
  const tries = [
    [1, 0],
    [-1, 0],
    [1, 1],
    [-1, 1],
    [1, -1],
    [-1, -1],
  ].map(([side, row]) => {
    const x = side > 0 ? city.pos[0] + gap : city.pos[0] - gap;
    const y = city.pos[1] + row * fontSize;
    return { x, y, anchor: side > 0 ? 'start' : 'end', box: { x: side > 0 ? x : x - w, y: y - fontSize / 2, w, h: fontSize } };
  });
  const pick = tries.find((t) => !boxes.some((b) => overlaps(t.box, b))) ?? tries[0];
  boxes.push(pick.box);
  return { city, ...pick };
});
---

<svg
  viewBox={`${x0} ${y0} ${width} ${height}`}
  class="block h-auto w-full"
  role="img"
  aria-label={`Map of the route: ${route.cities.map((city) => city.name).join(', ')}`}
>
  {CHINA_MAP.regions.map((shape) => (
    <path d={shape.d} class="fill-surface stroke-background" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  ))}
  <polyline
    points={line.map(([x, y]) => `${x},${y}`).join(' ')}
    fill="none"
    class="stroke-primary"
    stroke-width="2"
    stroke-linejoin="round"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />
  {labels.map(({ city, x, y, anchor }) => (
    <text
      x={x}
      y={y}
      text-anchor={anchor}
      dominant-baseline="central"
      class="fill-foreground stroke-background"
      font-size={fontSize}
      stroke-width="4"
      style="paint-order: stroke"
    >
      {city.name}
    </text>
  ))}
  {cities.map((city) => (
    <a href={`#day-${city.days[0]}`} aria-label={`${city.name}, days ${city.dayLabel}`}>
      <circle
        cx={city.pos[0]}
        cy={city.pos[1]}
        r={dotRadius}
        class="fill-foreground stroke-background"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      />
    </a>
  ))}
</svg>
