      <filter id={`gate-ink-${id}`} x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="7" />
        <feDisplacementMap in="SourceGraphic" scale="4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <linearGradient id={`gate-fade-${id}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.6" stop-color="white" />
        <stop offset="1" stop-color="white" stop-opacity="0.1" />
      </linearGradient>
      <mask id={`gate-mist-${id}`} maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="660">
        <rect width="1000" height="660" fill={`url(#gate-fade-${id})`} />
      </mask>
    </defs>
