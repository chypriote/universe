---
// An ink-painted paifang (牌坊): three bays, four columns, roofs with upturned eaves, tile ends,
// carved panels and braces, clasping drums at the feet.
// Ink is currentColor; the feet fade into the mist. The plaque slot holds brush letters.
// Paths come from a one-off script; edit them by hand.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Filter and mask ids must be unique when the gate is on a page twice.
const id = Math.random().toString(36).slice(2, 8);
