---
// Ink-wash scene (水墨): misty hills, a plum branch with cinnabar blossoms, a few birds.
// Ink is currentColor. Generated once by a script, then kept as static paths.
interface Props {
  class?: string;
  /** The plum branch with blossoms. */
  plum?: boolean;
  birds?: boolean;
}
const { class: className, plum = true, birds = true } = Astro.props;
// Filter and mask ids must be unique when the scene is on a page twice.
const id = Math.random().toString(36).slice(2, 8);
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" class={className}>
<defs>
<filter id={`ink-${id}`} x="-5%" y="-5%" width="110%" height="110%">
<feTurbulence type="fractalNoise" baseFrequency="0.015 0.03" numOctaves="3" seed="4"/>
<feDisplacementMap in="SourceGraphic" scale="14" xChannelSelector="R" yChannelSelector="G"/>
<feGaussianBlur stdDeviation="2.5"/>
</filter>
<linearGradient id={`fade-${id}`} x1="0" y1="0" x2="0" y2="1">
<stop offset="0.25" stop-color="white"/>
<stop offset="1" stop-color="black"/>
</linearGradient>
<mask id={`mist-${id}`} maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="500">
<rect width="1200" height="500" fill={`url(#fade-${id})`}/>
</mask>
</defs>
