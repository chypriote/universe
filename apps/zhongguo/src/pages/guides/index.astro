---
import TempleHeader from '@/components/TempleHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { guideZh } from '@/data/guide-zh';

const title = "Guides";
const description = "What to know before a trip to China: visa, internet, apps, payment, transport, food, etiquette and emergencies.";

const guides = (await getCollection('guides'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((guide) => ({
    title: guide.data.title,
    description: guide.data.description,
    href: `/guides/${guide.id}`,
    zh: guideZh[guide.id],
  }));

const groups = [
  { zh: '出发前', eyebrow: 'Before you fly', title: 'Sort it out at home', guides: guides.slice(0, 4), columns: 'md:grid-cols-2' },
  { zh: '旅途中', eyebrow: 'On the ground', title: 'Day to day', guides: guides.slice(4, 7), columns: 'md:grid-cols-3' },
  { zh: '遇险', eyebrow: 'If it goes wrong', title: 'Save these first', guides: guides.slice(7), columns: 'md:w-1/2 lg:w-1/3' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": `${SITE.url}/guides`
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <TempleHeader zh="指南" title="Guides">
    What to know before the trip, in eight steps: visa, internet, apps, payment, transport, food, etiquette and emergencies.
  </TempleHeader>
  <div class="py-8 lg:py-16">
    <Container>
      {groups.map((group) => (
        <section class="py-8 lg:py-10">
          <div class="mb-8 flex items-center gap-6">
            <span lang="zh" class="font-brush text-5xl lg:text-6xl leading-none" aria-hidden="true">{group.zh}</span>
            <div>
              <span class="eyebrow !text-base !tracking-[0.2em]">{group.eyebrow}</span>
              <h2 class="mt-2 text-h3 font-serif font-light">{group.title}</h2>
            </div>
          </div>
          <ol class={`grid gap-px bg-border border border-border ${group.columns}`}>
            {group.guides.map((guide) => (
              <li class="bg-background">
                <a href={guide.href} class="group relative flex h-full min-h-56 flex-col gap-4 overflow-hidden p-8 transition-colors hover:bg-surface">
                  <span lang="zh" aria-hidden="true" class="absolute top-14 right-6 font-brush text-[4rem] leading-none whitespace-nowrap text-gold-ink/[0.13] transition-colors group-hover:text-gold-ink/25">{guide.zh}</span>
                  <h3 class="relative font-serif text-2xl transition-colors group-hover:text-primary">{guide.title}</h3>
                  <p class="relative text-muted-foreground leading-relaxed">{guide.description}</p>
                  <span class="relative mt-auto eyebrow inline-flex items-center gap-2 pt-4">Read <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </Container>
  </div>
</BaseLayout>
