---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

  return guides.map((guide, index) => ({
    params: { slug: guide.id },
    props: { guide, previous: guides[index - 1], next: guides[index + 1] },
  }));
}

const { guide, previous, next } = Astro.props;
const { Content, headings } = await render(guide);
const sections = headings.filter((heading) => heading.depth === 2);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": guide.data.title,
  "description": guide.data.description,
  "url": `${SITE.url}/guides/${guide.id}`
};
---

<BaseLayout title={guide.data.title} description={guide.data.description} jsonLd={jsonLd}>
  <article class="py-20 lg:py-32">
    <Container>
      <nav class="mb-12">
        <a href="/guides" class="eyebrow text-muted-foreground hover:text-primary transition-colors">
          ← All guides
        </a>
      </nav>

      <header class="max-w-3xl mb-16">
        <span class="eyebrow mb-4 inline-block">Guide {String(guide.data.order).padStart(2, '0')} · Updated {guide.data.updated}</span>
        <h1 class="text-h1 font-serif font-light mb-8">{guide.data.title}</h1>
        <p class="text-xl text-muted-foreground leading-relaxed">{guide.data.description}</p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
        <aside class="lg:col-span-3">
          <nav class="lg:sticky lg:top-28" aria-label="On this page">
            <span class="eyebrow text-muted-foreground">On this page</span>
            <ol class="mt-4 border-t border-border">
              {sections.map((section) => (
                <li class="border-b border-border">
                  <a href={`#${section.slug}`} class="block py-3 text-sm hover:text-primary transition-colors">{section.text}</a>
                </li>
              ))}
            </ol>
            <div class="mt-8 flex flex-col gap-6">
              {next && (
                <div class="flex flex-col">
                  <span class="eyebrow text-muted-foreground mb-2">Next guide</span>
                  <a href={`/guides/${next.id}`} class="font-serif text-lg whitespace-nowrap hover:text-primary transition-colors">{next.data.title} →</a>
                </div>
              )}
              <a href="/guides" class="eyebrow text-muted-foreground hover:text-primary transition-colors">← All guides</a>
            </div>
          </nav>
        </aside>

        <div class="lg:col-span-9 min-w-0">
          <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:font-normal prose-h2:mt-16 prose-table:block prose-table:overflow-x-auto">
            <Content />
          </div>

          <footer class="mt-16 pt-16 bamboo-t flex flex-col sm:flex-row sm:justify-between items-start gap-8">
            {previous ? (
              <div class="flex flex-col">
                <span class="eyebrow text-muted-foreground mb-2">Previous</span>
                <a href={`/guides/${previous.id}`} class="text-lg font-serif whitespace-nowrap hover:text-primary transition-colors">← {previous.data.title}</a>
              </div>
            ) : <div />}
            {next && (
              <div class="flex flex-col sm:text-right sm:items-end">
                <span class="eyebrow text-muted-foreground mb-2">Next</span>
                <a href={`/guides/${next.id}`} class="text-lg font-serif whitespace-nowrap hover:text-primary transition-colors">{next.data.title} →</a>
              </div>
            )}
          </footer>
        </div>
      </div>
    </Container>
  </article>
</BaseLayout>
