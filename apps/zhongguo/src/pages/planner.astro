---
import TempleHeader from '@/components/TempleHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { flightPrices } from '@/lib/flight-prices';
import { formatDayMonth, formatEuros, formatMonth, monthName } from '@universe/universe/format';
import { publicReads } from '@/lib/journal';

export const prerender = false;

// Prices and covers are read on request.
const journal = publicReads();
const covers = new Map((await journal.listPlanCards()).map((card) => [card.slug, card]));
const { plans, searches, airports } = await journal.getFareData();
const today = new Date().toISOString().slice(0, 10);
const {
  first,
  last,
  plans: lanes,
} = flightPrices(
  plans,
  searches,
  new Map(airports.map((airport) => [airport.code, airport.name])),
  today,
);

// Up to 3 pictures per plan: its Highlight Photos, else the first pictures of its Activities.
const pictures = new Map<string, string[]>();
for (const plan of lanes) {
  let urls = covers.get(plan.slug)?.highlights ?? [];
  if (urls.length === 0) {
    const page = await journal.getPlan(plan.slug);
    urls = [
      ...new Set(
        page?.days
          .flatMap((day) => day.activities.map((activity) => activity.picture))
          .filter((url): url is string => url !== null),
      ),
    ];
  }
  pictures.set(plan.slug, urls.slice(0, 3));
}

const utc = (date: string) => Date.parse(`${date}T00:00:00Z`);
const start = utc(`${first.slice(0, 7)}-01`);
const lastMonth = new Date(`${last.slice(0, 7)}-01T00:00:00Z`);
const end = Date.UTC(lastMonth.getUTCFullYear(), lastMonth.getUTCMonth() + 1, 1);
const x = (date: string) => ((utc(date) - start) / (end - start)) * 100;
const months: { label: string; year: number }[] = [];
for (
  let cursor = new Date(start);
  cursor.getTime() < end;
  cursor.setUTCMonth(cursor.getUTCMonth() + 1)
) {
  months.push({ label: monthName(cursor.toISOString()), year: cursor.getUTCFullYear() });
}
const range = `${formatMonth(first.slice(0, 7))} – ${formatMonth(last.slice(0, 7))}`;
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const day = (date: string, weekday = false) =>
  `${weekday ? `${WEEKDAYS[new Date(`${date}T12:00:00Z`).getUTCDay()]} ` : ''}${formatDayMonth(date)}`;
const euros = (price: number) => formatEuros(price, { whole: true });

const run = (fit: { from: string; to: string }) =>
  fit.from === fit.to ? day(fit.from) : `${day(fit.from)} – ${day(fit.to)}`;

const title = 'Plan';
const description =
  'When to leave for each suggested itinerary: the cheapest flights from Paris in the best months to go.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: Astro.url.href,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <TempleHeader zh="出发" title="Plan">
    {description}
  </TempleHeader>
  <div class="py-16 lg:py-24">
    <Container>
      {lanes.length === 0 ? (
        <p class="text-muted-foreground">No plans with Days yet.</p>
      ) : (
        <>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-4">
            <p class="eyebrow">{range}</p>
            <p class="text-xs text-muted-foreground">
              <span class="inline-block w-3 h-3 bg-gold/45 align-middle mr-1" /> Recommended dates ·{' '}
              <span class="inline-block w-5 h-1.5 bg-primary align-middle mx-1" /> cheapest flights
            </p>
          </div>
          <div class="grid lg:grid-cols-[13rem_1fr]">
            <div class="hidden lg:block" />
            <div
              class="grid border-b border-foreground"
              style={`grid-template-columns: repeat(${months.length}, minmax(0, 1fr))`}
            >
              {months.map((month) => (
                <span class="eyebrow text-muted-foreground text-center py-2 !tracking-[0.12em]">
                  <span class="sm:hidden">{month.label[0]}</span>
                  <span class="hidden sm:inline">{month.label}</span>
                </span>
              ))}
            </div>
          </div>
          {lanes.map((plan, index) => (
            <button
              type="button"
              data-plan={plan.slug}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-controls={`fares-${plan.slug}`}
              class="group grid lg:grid-cols-[13rem_1fr] w-full text-left border-b border-border border-l-2 border-l-transparent aria-pressed:border-l-primary hover:bg-surface/50 aria-pressed:bg-surface/70 transition-colors"
            >
              <span class="relative overflow-hidden pt-4 pb-2 lg:py-4 pl-4 pr-3">
                {plan.zh && (
                  <span
                    lang="zh"
                    aria-hidden="true"
                    class="font-brush absolute right-1 -top-1 text-6xl leading-none text-gold-ink/[0.13]"
                  >
                    {plan.zh}
                  </span>
                )}
                <span class="relative block font-serif text-lg">{plan.title}</span>
                <span class="relative block text-xs text-muted-foreground">
                  {plan.days} days ·{' '}
                  {plan.windows.length > 0
                    ? `from ${euros(plan.windows[0].price)}`
                    : 'no prices yet'}
                </span>
              </span>
              <span
                class="relative block h-16 lg:h-auto opacity-60 group-aria-pressed:opacity-100 transition-opacity"
                aria-hidden="true"
              >
                {plan.fits.map((fit) => (
                  <span
                    class="absolute inset-y-0 bg-gold/45"
                    title={`Recommended dates: ${run(fit)}`}
                    style={`left:${x(fit.from)}%;width:${x(fit.to) - x(fit.from) + 100 / ((end - start) / 864e5)}%`}
                  />
                ))}
                {plan.windows.map((window, rank) => (
                  <span
                    class="absolute"
                    title={`${day(window.outbound, true)} – ${day(window.return)} · ${euros(window.price)}`}
                    style={`left:${x(window.outbound)}%;width:${x(window.return) - x(window.outbound)}%;top:${30 + rank * 18}%`}
                  >
                    <span class={`block h-1.5 ${rank === 0 ? 'bg-primary' : 'bg-primary/45'}`} />
                    {rank === 0 && (
                      <span class="absolute left-full ml-1.5 -top-1.5 text-xs font-semibold tabular-nums whitespace-nowrap">
                        {euros(window.price)}
                      </span>
                    )}
                  </span>
                ))}
              </span>
            </button>
          ))}
          <div class="mt-10 grid lg:grid-cols-[13rem_1fr] gap-x-6 gap-y-3" aria-live="polite">
            {lanes.map((plan, index) => {
              const urls = pictures.get(plan.slug) ?? [];
              return (
                <>
                  {urls.length > 0 && (
                    <div
                      data-fares={plan.slug}
                      class:list={['max-lg:hidden relative', index > 0 && 'hidden']}
                      aria-hidden="true"
                    >
                      {urls.map((url, rank) => (
                        <img
                          src={url}
                          alt=""
                          loading="lazy"
                          class="relative aspect-[4/3] w-full object-cover border-[3px] border-background"
                          style={`margin-top:${rank === 0 ? 0 : -1.5}rem;margin-left:${rank % 2}rem;width:calc(100% - 1rem)`}
                        />
                      ))}
                    </div>
                  )}
                  <div
                    id={`fares-${plan.slug}`}
                    data-fares={plan.slug}
                    class:list={[index > 0 && 'hidden', urls.length === 0 && 'lg:col-start-2']}
                  >
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 pb-1">
                      <h3 class="font-script text-4xl leading-[1.05] pb-3 lg:text-5xl">
                        {plan.title}
                      </h3>
                      <a
                        href={`/plans/${plan.slug}`}
                        class="text-sm text-primary underline-offset-4 hover:underline"
                      >
                        See the plan <span aria-hidden="true">→</span>
                      </a>
                    </div>
                    {plan.fits.length > 0 && (
                      <p class="text-sm text-muted-foreground">
                        Recommended dates: {plan.fits.map(run).join(', ')}.
                      </p>
                    )}
                    <p class="eyebrow mt-5 mb-2">Cheapest dates</p>
                    <ol class="divide-y divide-border/70 border-t border-border">
                      {plan.note && (
                        <li class="py-3 text-sm text-muted-foreground">
                          No prices yet ({plan.note}).
                        </li>
                      )}
                      {plan.windows.map((window, rank) => (
                        <li class="py-3 grid grid-cols-[1fr_auto] items-baseline gap-x-6">
                          <span>
                            <span class="font-serif text-lg">
                              {day(window.outbound, true)} – {day(window.return)}
                            </span>
                            <span class="block text-sm text-muted-foreground">
                              {window.city} {window.airport} ·{' '}
                              {window.direct ? 'direct' : 'with stops'} · price of{' '}
                              {day(window.searchedOn)}
                            </span>
                          </span>
                          <span
                            class:list={[
                              'font-serif text-2xl tabular-nums',
                              rank === 0 && 'text-secondary',
                            ]}
                          >
                            {euros(window.price)}
                          </span>
                        </li>
                      ))}
                    </ol>
                  </div>
                </>
              );
            })}
          </div>
        </>
      )}
    </Container>
    <div class="mt-12">
      {lanes.map((plan, index) => {
        const card = covers.get(plan.slug);
        return (
          card?.cover && (
            <div
              data-cover={plan.slug}
              class:list={[
                'relative isolate h-[30rem] overflow-hidden lg:h-[33rem]',
                index > 0 && 'hidden',
              ]}
            >
              <img
                src={card.cover}
                alt=""
                loading="lazy"
                class="absolute inset-0 -z-10 h-full w-full object-cover mist-bottom"
                style={`object-position: ${card.coverFocus.x}% ${card.coverFocus.y}%`}
              />
            </div>
          )
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  // Hover, focus or tap a plan: its lane comes forward, and its cheapest dates and cover show below.
  // A click locks that plan: other lanes ignore hover until Esc or a click outside the lanes.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-plan]');
  let locked = false;
  const show = (slug: string) => {
    buttons.forEach((button) =>
      button.setAttribute('aria-pressed', String(button.dataset.plan === slug)),
    );
    document
      .querySelectorAll<HTMLElement>('[data-fares], [data-cover]')
      .forEach((item) =>
        item.classList.toggle('hidden', (item.dataset.fares ?? item.dataset.cover) !== slug),
      );
  };
  buttons.forEach((button) => {
    const slug = button.dataset.plan!;
    button.addEventListener('mouseenter', () => !locked && show(slug));
    button.addEventListener('focus', () => !locked && show(slug));
    button.addEventListener('click', () => {
      locked = true;
      show(slug);
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') locked = false;
  });
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-plan]')) locked = false;
  });
</script>
