---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { FlightPlanner } from '@/components/islands/FlightPlanner';
import { getRecentFlightSearches } from '@/lib/flights.server';

const flights = await getRecentFlightSearches();

const title = "Flight prices";
const description = "The flight prices I track to China and nearby, as a table and a price calendar.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": Astro.url.href
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="py-20 lg:py-28">
    <Container>
      <header class="max-w-3xl mb-16 lg:mb-20">
        <span class="eyebrow">Planner</span>
        <h1 class="mt-4 text-h1 font-serif font-light">Flight prices</h1>
        <p class="mt-6 text-lg text-muted-foreground leading-relaxed max-w-2xl">
          The fares I track to China and nearby. Recent searches on the left, a price calendar on the right.
        </p>
      </header>

      <FlightPlanner client:only="react" flights={flights}>
        <p class="text-muted-foreground text-sm">Loading flight planner…</p>
      </FlightPlanner>
    </Container>
  </div>
</BaseLayout>
