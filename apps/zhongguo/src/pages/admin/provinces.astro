---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminProvinces } from '@/components/islands/AdminProvinces';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const journal = journalFromEnv();
const [provinces, activities, cities] = await Promise.all([journal.listAdminProvinces(), journal.listAdminActivities(), journal.listCities()]);
const requested = Number(Astro.url.searchParams.get('province'));
const province = provinces.find((candidate) => candidate.id === requested) ?? provinces[0];
---

<AdminLayout title="Provinces">
  {
    province ? (
      <AdminProvinces client:load provinces={provinces} provinceId={province.id} activities={activities} cities={cities} />
    ) : (
      <p class="text-muted-foreground">There is no Province yet.</p>
    )
  }
</AdminLayout>
