---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminCities } from '@/components/islands/AdminCities';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const journal = journalFromEnv();
const [cities, provinces, activities] = await Promise.all([journal.listAdminCities(), journal.listProvinces(), journal.listAdminActivities()]);
const requested = Number(Astro.url.searchParams.get('city'));
const city = cities.find((candidate) => candidate.id === requested) ?? cities[0];
const photos = city ? ((await journal.listCityPhotos(city.id)) ?? []) : [];
---

<AdminLayout title="Cities">
  {
    city ? (
      <div>
        <AdminCities client:load cities={cities} cityId={city.id} photos={photos} provinces={provinces} activities={activities} />
      </div>
    ) : (
      <p class="text-muted-foreground">There is no City yet.</p>
    )
  }
</AdminLayout>
