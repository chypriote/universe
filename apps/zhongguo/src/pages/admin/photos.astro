---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminPhotos } from '@/components/islands/AdminPhotos';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const journal = journalFromEnv();
const trips = await journal.listAdminTrips();
const tripSlug = trips.find((trip) => trip.slug === Astro.url.searchParams.get('trip'))?.slug ?? trips[0]?.slug;
const photos = tripSlug ? ((await journal.listAdminPhotos(tripSlug)) ?? []) : [];
const [cities, provinces] = await Promise.all([journal.listCities(), journal.listProvinces()]);
---

<AdminLayout title="Photos">
  <p class="eyebrow">Admin</p>
  <h1 class="mt-3 font-serif text-h1">Photos</h1>
  {
    tripSlug ? (
      <div class="mt-10">
        <AdminPhotos client:load trips={trips} tripSlug={tripSlug} photos={photos} cities={cities} provinces={provinces} />
      </div>
    ) : (
      <p class="mt-6 text-muted-foreground">There is no Trip yet.</p>
    )
  }
</AdminLayout>
