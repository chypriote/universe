---
import JournalLayout from '@/layouts/JournalLayout.astro';
import { AdminPlanEditor } from '@/components/islands/AdminPlanEditor';
import { atlas, journalWorkspace } from '@/lib/journal';
import { hasSeasonStart } from '@/lib/flight-prices';

export const prerender = false;

const journal = journalWorkspace();
const atlasReads = atlas();
const plan = await journal.getAdminPlan(Astro.params.slug ?? '');
if (!plan) return Astro.redirect('/admin/plans');
const [cities, activities] = await Promise.all([
  atlasReads.listAdminCities(),
  atlasReads.listAdminActivities(),
]);
const offSeason =
  plan.seasons.length > 0 && !hasSeasonStart(plan.seasons, new Date().toISOString().slice(0, 10));
---

<JournalLayout title={plan.title} current={{ kind: 'plan', slug: plan.slug }}>
  <div class="flex flex-col gap-12">
    {offSeason && (
      <p role="status" class="border border-error p-4 text-sm text-error">
        No start date fits this plan's Seasons, so it gets no flight prices. Set the Seasons of its
        Provinces in{' '}
        <a href="/admin/atlas" class="underline">
          Atlas
        </a>
        .
      </p>
    )}
    <AdminPlanEditor client:load plan={plan} cities={cities} activities={activities} />
  </div>
</JournalLayout>
