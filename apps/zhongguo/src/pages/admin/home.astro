---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminHome } from '@/components/islands/AdminHome';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const provinces = await journalFromEnv().listVisitedProvinces();
---

<AdminLayout title="Home">
  <p class="max-w-2xl text-muted-foreground">
    The photo of each Visited Province on the home map. Without a chosen cover, the Province shows its first Photo.
  </p>
  <div class="mt-6">
    <AdminHome client:load provinces={provinces} />
  </div>
</AdminLayout>
