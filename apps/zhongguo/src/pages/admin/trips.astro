---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminTrips } from '@/components/islands/AdminTrips';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const trips = await journalFromEnv().listAdminTrips();
---

<AdminLayout title="Trips">
  <div>
    <AdminTrips client:load trips={trips} />
  </div>
</AdminLayout>
