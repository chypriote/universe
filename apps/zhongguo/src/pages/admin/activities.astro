---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminActivities } from '@/components/islands/AdminActivities';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const journal = journalFromEnv();
const [activities, cities] = await Promise.all([journal.listAdminActivities(), journal.listCities()]);
---

<AdminLayout title="Activities">
  <AdminActivities client:load activities={activities} cities={cities} />
</AdminLayout>
