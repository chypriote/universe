---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import CompletedTrips from '@/components/home/CompletedTrips.astro';
import SuggestedTrips from '@/components/home/SuggestedTrips.astro';
import RegionRecommendations from '@/components/home/RegionRecommendations.astro';
import { getCollection } from 'astro:content';
import { buildGalleryArchive, buildTripArchiveEntry, isPublishedItinerary } from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const publishedTrips = await Promise.all(
  itineraries
    .filter(isPublishedItinerary)
    .sort(
      (a, b) =>
        (b.data.released_itinerary.start_date ?? '').localeCompare(
          a.data.released_itinerary.start_date ?? '',
        ),
    )
    .map(buildTripArchiveEntry),
);
const { photos } = await buildGalleryArchive(itineraries.filter(isPublishedItinerary));
const completedTrips = publishedTrips.filter((trip) => trip.type === 'report');
const suggestedTrips = publishedTrips.filter((trip) => trip.type === 'plan');
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <Hero />
  <CompletedTrips trips={completedTrips} />
  <SuggestedTrips trips={suggestedTrips} />
  <RegionRecommendations trips={publishedTrips} photos={photos} />
</BaseLayout>

<style is:global>
  /* Snap each home page section to the top. The footer snaps to the bottom so it stays reachable.
     The extra 7px shows the whole bamboo bar (12px, centred on the section edge) below the header border. */
  html {
    scroll-snap-type: y mandatory;
    scroll-padding-top: calc(var(--nav-height) + 7px);
  }
  footer {
    scroll-snap-align: end;
  }
  /* The bamboo stops at the bamboo bar under the hero (nav + hero height, see Hero.astro, + half the 12px bar). */
  #bamboo-grove {
    top: calc(var(--nav-height) + max(100svh - var(--nav-height), 600px) + 6px);
  }
</style>
