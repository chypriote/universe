---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import CompletedTrips from '@/components/home/CompletedTrips.astro';
import SuggestedTrips from '@/components/home/SuggestedTrips.astro';
import RegionRecommendations from '@/components/home/RegionRecommendations.astro';
import { publicReads } from '@/lib/journal';

export const prerender = false;

const journal = publicReads();
const completedTrips = await journal.listTripCards();
const suggestedTrips = await journal.listPlanCards();
const provinces = await journal.getHomeMap();
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <Hero />
  <CompletedTrips trips={completedTrips} />
  <SuggestedTrips trips={suggestedTrips} />
  <RegionRecommendations provinces={provinces} />
</BaseLayout>

<style is:global>
  /* Snap each home page section to the top. The footer snaps to the bottom so it stays reachable.
     The extra 7px shows the whole bamboo bar (12px, centred on the section edge) below the header border. */
  html {
    scroll-snap-type: y mandatory;
    scroll-padding-top: calc(var(--nav-height) + 7px);
  }
  footer {
    scroll-snap-align: end;
  }
  /* The bamboo tops end inside the hero, half in mist, so the page opens at the top of the grove. */
  #bamboo-grove {
    top: calc(var(--nav-height) + 12svh);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.3), black 360px);
  }
</style>
