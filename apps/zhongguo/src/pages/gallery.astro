---
import TempleHeader from '@/components/TempleHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { GalleryArchive } from '@/components/islands/GalleryArchive';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import {
  buildGalleryArchive,
  isPublishedItinerary,
} from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const archive = await buildGalleryArchive(itineraries.filter(isPublishedItinerary));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": `Photography Archive — ${SITE.name}`,
  "description": "Photos from my trips in China, by region and city.",
  "url": `${SITE.url}/gallery`
};
---

<BaseLayout title="Photography" description="Photos from my trips in China, by region and city." jsonLd={jsonLd}>
  <TempleHeader zh="影集" title="Photos">
    Photos from every trip. Filter by region or city, then open a city to read that day of the journal.
  </TempleHeader>
  <div class="py-16 lg:py-24">
    <Container>

      <GalleryArchive client:load photos={archive.photos} regions={archive.regions} cities={archive.cities} />

      <div class="mt-24 pt-16 bamboo-t flex flex-col md:flex-row md:items-center justify-between gap-6">
        <p class="font-serif text-2xl font-light">Each trip has a day-by-day journal with the route and notes.</p>
        <a href="/trips" class="btn btn-outline shrink-0">All journeys</a>
      </div>
    </Container>
  </div>
</BaseLayout>
