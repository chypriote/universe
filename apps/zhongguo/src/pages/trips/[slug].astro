---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import TripRouteSection from '@/components/TripRouteSection.astro';
import { TripDayGallery } from '@/components/islands/TripDayGallery';
import { PlanCalendar } from '@/components/islands/PlanCalendar';
import { SITE } from '@/config/site';
import { env } from 'cloudflare:workers';
import { journalFromEnv } from '@/lib/journal';

export const prerender = false;

const { slug } = Astro.params;
const journal = journalFromEnv();
const trip = slug ? await journal.getTrip(slug) : null;
if (!trip) {
  // A missing or Hidden Trip: the site's 404 page, with the 404 status.
  const { ASSETS } = env as unknown as { ASSETS: Fetcher };
  const notFound = await ASSETS.fetch(new URL('/404', Astro.url));
  return new Response(notFound.body, { status: 404, headers: notFound.headers });
}

const cards = await journal.listTripCards();
const card = cards.find((entry) => entry.slug === slug)!;
const cover = card.cover;

const otherTrips = cards
  .filter((other) => other.slug !== slug)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TravelAction",
  "name": trip.title,
  "description": trip.description,
  "url": `${SITE.url}/trips/${slug}`,
  "location": {
    "@type": "Place",
    "name": trip.destination
  }
};
---

<BaseLayout title={trip.title} description={trip.description} jsonLd={jsonLd}>
  <article>
    <header class="snap-start relative isolate flex justify-center overflow-hidden text-center">
      {cover && <img src={cover} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" style={`object-position: ${card.coverFocus.x}% ${card.coverFocus.y}%`} />}
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
      <div class="flex flex-col items-center gap-5 px-4 pt-14 pb-24 lg:pt-20 lg:pb-32">
        <h1 class="font-script text-6xl leading-[1.05] pb-2 lg:text-[9rem] animate-fade-in">{trip.title}</h1>
        <p class="max-w-lg font-serif text-lg text-foreground/80">{trip.description}</p>
        <div class="mt-4 flex flex-col items-center gap-2 border-t border-foreground/30 pt-5 eyebrow text-foreground">
          <span>{trip.dates}</span>
          <span>{trip.days.length} days</span>
        </div>
      </div>
    </header>

    <TripRouteSection route={trip.route} regions={card.provinces} />

    {/* Day by day: a timeline of the route */}
    <div class="py-20 lg:py-28">
      <Container>
        <div class="mx-auto max-w-6xl">
          {trip.days.map((day, index) => {
            // The left column names the Cities of a Day when it moves on or spans several.
            const showCities = day.cities.length > 1 || trip.days[index - 1]?.cities.at(-1)?.name !== day.cities[0].name;
            return (
              <section class="snap-start lg:grid lg:grid-cols-[14rem_1fr]" id={`day-${day.number}`}>
                <div class="hidden lg:block">
                  {showCities && (
                    <div class="space-y-2 pr-8">
                      {day.cities.map((city) => (
                        <div class="relative isolate flex min-h-20 items-center justify-end">
                          <span lang="zh" aria-hidden="true" class:list={['absolute right-0 top-1/2 -z-10 -translate-y-1/2 whitespace-nowrap font-brush leading-none text-gold-ink/25', city.major ? 'text-[4rem]' : 'text-[2.7rem]']}>{city.nameZh}</span>
                          <span class:list={['eyebrow text-foreground', !city.major && 'text-[0.625rem]']}>{city.name}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
                <div class="relative space-y-6 border-gold-ink/50 pb-20 lg:border-l lg:pl-14 lg:pb-24">
                  <span class="absolute -left-[7px] top-3 hidden h-3.5 w-3.5 rounded-full bg-primary ring-4 ring-background lg:block" aria-hidden="true"></span>
                  <span class="eyebrow text-muted-foreground lg:hidden">
                    {day.cities.map((city, i) => <>{i > 0 && ' → '}{city.name} <span lang="zh">{city.nameZh}</span></>)}
                  </span>
                  <div class="flex items-baseline gap-4">
                    <span class="font-serif text-5xl text-gold-ink">{String(day.number).padStart(2, '0')}</span>
                    <h2 class="text-h3 font-serif">{day.title}</h2>
                  </div>
                  <p class="max-w-2xl text-lg leading-relaxed text-foreground/85">{day.notes}</p>

                  {(day.activities.length > 0 || day.food.length > 0) && (
                    <div class="grid gap-8 border-t border-border pt-5 sm:grid-cols-2">
                      {day.activities.length > 0 && (
                        <div class="space-y-3">
                          <span class="eyebrow">Activities</span>
                          <ul class="space-y-2.5">
                            {day.activities.map((activity) => (
                              <li class="flex items-start gap-2">
                                <span class="mt-2.5 h-1 w-1 shrink-0 bg-primary" aria-hidden="true"></span>
                                <span>
                                  <span class="block font-serif text-lg leading-tight">{activity.name}</span>
                                  <span class="block text-xs text-muted-foreground">
                                    <span lang="zh">{activity.nameZh}</span>
                                    <span class="ml-1.5">{activity.pinyin}</span>
                                  </span>
                                </span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {day.food.length > 0 && (
                        <div class="space-y-3">
                          <span class="eyebrow">Food</span>
                          <ul class="space-y-2">
                            {day.food.map((item) => (
                              <li class="font-serif text-lg leading-tight text-foreground/80">{item}</li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}

                  {day.photos.length > 0 && (
                    <TripDayGallery client:visible photos={day.photos} day={day.number} tripTitle={trip.title} />
                  )}

                  {day.rides.map((ride) => (
                    <div class="flex items-center gap-4">
                      <span class="h-px flex-1 bg-gold-ink/40"></span>
                      <span class="eyebrow text-primary">{ride}</span>
                      <span class="h-px flex-1 bg-gold-ink/40"></span>
                    </div>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </Container>
    </div>

    {trip.planDays.length > 0 && (
      <section id="calendar" class="snap-start bamboo-t py-20 lg:py-32">
        <Container>
          <PlanCalendar client:load days={trip.planDays} startDate={trip.startDate} />
        </Container>
      </section>
    )}

    {/* Other Journeys */}
    <section class="snap-start bamboo-t py-20 lg:py-28">
      <Container>
        {otherTrips.length > 0 && (
          <div class="space-y-12 mb-20 lg:mb-28">
            <div class="text-center space-y-3">
              <span class="eyebrow">Keep reading</span>
              <h2 class="text-h2 font-serif font-light">Other journeys</h2>
            </div>

            <div class={`grid gap-10 lg:gap-16 ${otherTrips.length === 1 ? 'max-w-xl mx-auto' : otherTrips.length === 2 ? 'md:grid-cols-2 max-w-4xl mx-auto' : 'md:grid-cols-3'}`}>
              {otherTrips.map((other) => (
                <a href={other.link} class="group block space-y-4">
                  {other.cover && (
                    <div class="relative overflow-hidden aspect-[4/3] bg-background">
                      <img
                        src={other.cover}
                        alt={other.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="space-y-2">
                    <span class="eyebrow text-muted-foreground">
                      {other.dates}
                    </span>
                    <h3 class="text-2xl font-serif group-hover:text-primary transition-colors">
                      {other.title}
                    </h3>
                    <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                      {other.description}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="flex justify-center">
          <a
            href="/trips"
            class="btn btn-outline"
          >
            All journeys
          </a>
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>

<style is:global>
  /* One scroll step per section: cover, route, each day, then the closing sections. The footer snaps to the bottom so it stays reachable. */
  html {
    scroll-snap-type: y mandatory;
    scroll-padding-top: calc(var(--nav-height) + 7px);
  }
  /* A fast scroll or a long wheel burst stops at each section instead of flying past it. */
  .snap-start {
    scroll-snap-stop: always;
  }
  footer {
    scroll-snap-align: end;
  }
  /* The bamboo tops end inside the cover, half in mist, as on the index pages. */
  #bamboo-grove {
    top: calc(var(--nav-height) + 6rem);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.3), black 360px);
  }
</style>
