---
import { env } from 'cloudflare:workers';
import TripView from '@/components/TripView.astro';
import { publicReads } from '@/lib/journal';

export const prerender = false;

const { slug } = Astro.params;
const journal = publicReads();
const trip = slug ? await journal.getTrip(slug) : null;
if (!trip) {
  // A missing or Hidden Trip: the site's 404 page, with the 404 status.
  const { ASSETS } = env as unknown as { ASSETS: Fetcher };
  const notFound = await ASSETS.fetch(new URL('/404', Astro.url));
  return new Response(notFound.body, { status: 404, headers: notFound.headers });
}

const cards = await journal.listTripCards();
---

<TripView trip={trip} card={cards.find((entry) => entry.slug === slug)!} others={cards} base="/trips" />
