---
import TempleHeader from '@/components/TempleHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import TripArchive from '@/components/TripArchive.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { buildTripArchiveEntry, isPublishedItinerary } from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const trips = await Promise.all(
  itineraries
    .filter(isPublishedItinerary)
    .sort(
      (a, b) =>
        (b.data.released_itinerary.start_date ?? '').localeCompare(
          a.data.released_itinerary.start_date ?? '',
        ),
    )
    .map(buildTripArchiveEntry),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Journeys — ${SITE.name}`,
  "description": "Trip reports and trip plans from my travels in China.",
  "url": `${SITE.url}/trips/`
};
---

<BaseLayout title="Journeys" description="Trip reports and trip plans from my travels in China." jsonLd={jsonLd}>
  <TempleHeader zh="游记" title="Journeys">
    Trip reports from the road, day by day, and plans for the next trips.
  </TempleHeader>
  <div class="py-16 lg:py-24">
    <Container>
      <TripArchive trips={trips} />
    </Container>
  </div>
</BaseLayout>

<style is:global>
  /* Snap to the header at the top, then to each journey, centred, as in the home Recent journeys section.
     The footer snaps to the bottom so it stays reachable. */
  html {
    scroll-snap-type: y mandatory;
  }
  main > header {
    scroll-snap-align: start;
  }
  footer {
    scroll-snap-align: end;
  }
</style>
