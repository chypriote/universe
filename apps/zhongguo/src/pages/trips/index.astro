---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import TripArchive from '@/components/TripArchive.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { buildTripArchiveEntry, isPublishedItinerary } from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const trips = await Promise.all(
  itineraries
    .filter(isPublishedItinerary)
    .sort(
      (a, b) =>
        (b.data.released_itinerary.start_date ?? '').localeCompare(
          a.data.released_itinerary.start_date ?? '',
        ),
    )
    .map(buildTripArchiveEntry),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Journeys — ${SITE.name}`,
  "description": "Trip reports and trip plans from my travels in China.",
  "url": `${SITE.url}/trips/`
};
---

<BaseLayout title="Journeys" description="Trip reports and trip plans from my travels in China." jsonLd={jsonLd}>
  <div class="py-20 lg:py-28">
    <Container>
      <header class="max-w-3xl mb-16 lg:mb-20">
        <span class="eyebrow">Archive</span>
        <h1 class="mt-4 text-h1 font-serif font-light">Journeys</h1>
        <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
          Trip reports from the road, day by day, and plans for the next trips.
        </p>
      </header>

      <TripArchive trips={trips} />
    </Container>
  </div>
</BaseLayout>
