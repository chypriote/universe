---
import InkWash from '@/components/InkWash.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import TripArchive from '@/components/TripArchive.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { buildTripArchiveEntry, isPublishedItinerary } from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const trips = await Promise.all(
  itineraries
    .filter(isPublishedItinerary)
    .sort(
      (a, b) =>
        (b.data.released_itinerary.start_date ?? '').localeCompare(
          a.data.released_itinerary.start_date ?? '',
        ),
    )
    .map(buildTripArchiveEntry),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Journeys — ${SITE.name}`,
  "description": "Trip reports and trip plans from my travels in China.",
  "url": `${SITE.url}/trips/`
};
---

<BaseLayout title="Journeys" description="Trip reports and trip plans from my travels in China." jsonLd={jsonLd}>
  <header class="bamboo-b">
    <div class="absolute inset-0 overflow-hidden">
      <InkWash plum={false} birds={false} class="absolute inset-0 w-full h-full text-foreground opacity-60 md:opacity-100" />
    </div>
    <div class="relative z-10 flex flex-col items-center px-4 pt-14 pb-24 lg:pt-20 lg:pb-32 text-center">
      <h1>
        <span class="relative inline-block">
          <span lang="zh" class="block font-brush text-[clamp(3.5rem,2rem+5vw,6.5rem)] leading-none tracking-[0.05em]" aria-hidden="true">游记</span>
          <span lang="zh" class="seal absolute -right-6 lg:-right-10 -bottom-1 w-6 lg:w-8 text-[0.65rem] lg:text-sm" aria-hidden="true">中</span>
        </span>
        <span class="mt-5 block font-serif uppercase font-light tracking-[0.35em] text-sm lg:text-base text-gold-ink">Journeys</span>
      </h1>
      <p class="mt-5 text-lg text-muted-foreground leading-relaxed max-w-xl">
        Trip reports from the road, day by day, and plans for the next trips.
      </p>
    </div>
  </header>
  <div class="py-16 lg:py-24">
    <Container>
      <TripArchive trips={trips} />
    </Container>
  </div>
</BaseLayout>

<style is:global>
  /* The bamboo tops end inside the hero, half in mist, as on the home page. */
  #bamboo-grove {
    top: calc(var(--nav-height) + 6rem);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.3), black 360px);
  }
</style>
