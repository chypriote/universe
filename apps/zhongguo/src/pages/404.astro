---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title={`Page Not Found – ${SITE.name}`}
  description="The page you requested could not be found."
>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-6 py-32 text-center">
    <span class="seal w-14 text-3xl" aria-hidden="true">
      迷
    </span>
    <p class="mt-8 eyebrow">404</p>
    <h1 class="mt-4 text-h1 font-serif font-light">Page not found</h1>
    <p class="mt-6 mb-10 text-lg text-muted-foreground">This page does not exist, or it moved.</p>
    <a href="/" class="btn btn-primary">
      Back to the home page
    </a>
  </div>
</BaseLayout>
