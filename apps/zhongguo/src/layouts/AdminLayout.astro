---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import SEOHead from '@/components/SEOHead.astro';
import Container from '@/components/Container.astro';

export interface Props {
  title: string;
  /** Shows the sidebar with Trips, Photos, Cities and Home, and Log out. Off on the login page. */
  nav?: boolean;
}

const { title, nav = true } = Astro.props;
import { ADMIN_SECTIONS as links } from '@/lib/admin-sections';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <Font cssVariable="--font-inter" preload />
    <SEOHead title={`${title} · Admin`} noIndex={true} />
  </head>
  <body class="min-h-svh">
    <header class="border-b border-border bg-background">
      <Container class="flex flex-wrap items-center justify-between gap-x-10 gap-y-3 py-4">
        <a href={nav ? '/admin' : '/admin/login'} class="flex items-center gap-3 no-underline text-foreground">
          <span class="seal w-8 text-base" aria-hidden="true">中</span>
          <span class="font-serif text-xl tracking-tight">Admin</span>
        </a>
        {nav && (
          <form method="post" action="/admin/logout">
            <button type="submit" class="eyebrow text-muted-foreground hover:text-primary cursor-pointer">Log out</button>
          </form>
        )}
      </Container>
    </header>
    <main>
      <Container class="py-12 lg:py-16">
        {nav ? (
          <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
            <nav aria-label="Admin" class="lg:sticky lg:top-8 lg:self-start">
              <ul class="grid grid-cols-2 gap-px border border-border bg-border lg:grid-cols-1">
                {links.map((link) => (
                  <li class="bg-background">
                    <a
                      href={link.href}
                      aria-current={isCurrent(link.href) ? 'page' : undefined}
                      class="block h-full border-l-2 border-transparent p-4 no-underline text-foreground hover:text-primary aria-[current=page]:border-primary aria-[current=page]:bg-muted/40 lg:p-5"
                    >
                      <span class="font-serif text-xl">{link.label}</span>
                      <span class="mt-1 hidden text-xs text-muted-foreground lg:block">{link.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/" class="mt-6 flex items-center gap-3 no-underline text-muted-foreground hover:text-primary">
                <span class="seal w-8 text-base" aria-hidden="true">中</span>
                <span class="eyebrow">Back home</span>
              </a>
            </nav>
            <div class="mt-10 min-w-0 lg:mt-0">
              <slot />
            </div>
          </div>
        ) : (
          <slot />
        )}
      </Container>
    </main>
  </body>
</html>
