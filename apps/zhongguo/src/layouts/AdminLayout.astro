---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import SEOHead from '@/components/SEOHead.astro';
import Container from '@/components/Container.astro';
import { ADMIN_WORKSPACES } from '@/lib/admin-workspaces';

export interface Props {
  title: string;
  /** Shows the workspace tabs and Log out. Off on the login page. */
  nav?: boolean;
  /** Shows the title as the page heading. Off when the page has its own. */
  heading?: boolean;
}

const { title, nav = true, heading = true } = Astro.props;
const path = Astro.url.pathname;
const within = (href: string) => path === href || path.startsWith(`${href}/`);
const workspace = ADMIN_WORKSPACES.find((item) => item.paths.some(within));
const journalLinks = [
  { href: '/admin/trips', label: 'Trips' },
  { href: '/admin/plans', label: 'Plans' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <Font cssVariable="--font-inter" preload />
    <SEOHead title={`${title} · Admin`} noIndex={true} />
  </head>
  <body class="min-h-svh">
    <header class="border-b border-border bg-background">
      <Container class="flex flex-wrap items-stretch gap-x-10 gap-y-2">
        <a href={nav ? '/admin' : '/admin/login'} class="flex items-center gap-3 py-4 no-underline text-foreground">
          <span class="seal w-8 text-base" aria-hidden="true">中</span>
          <span class="font-serif text-xl tracking-tight">Admin</span>
        </a>
        {nav && (
          <nav aria-label="Admin" class="flex items-stretch gap-8">
            {ADMIN_WORKSPACES.map((item) => (
              <a
                href={item.href}
                aria-current={item === workspace ? 'page' : undefined}
                class="flex items-center border-b-2 border-transparent font-serif text-lg no-underline text-muted-foreground hover:text-primary aria-[current=page]:border-primary aria-[current=page]:text-foreground"
              >
                {item.label}
              </a>
            ))}
          </nav>
        )}
        {nav && (
          <form method="post" action="/admin/logout" class="ml-auto flex items-center">
            <button type="submit" class="eyebrow text-muted-foreground hover:text-primary cursor-pointer">Log out</button>
          </form>
        )}
      </Container>
    </header>
    <main>
      <Container class="py-8 lg:py-10">
        {workspace?.label === 'Journal' && (
          <nav aria-label="Journal" class="mb-8 flex gap-6 text-sm">
            {journalLinks.map((link) => (
              <a href={link.href} aria-current={within(link.href) ? 'page' : undefined} class="eyebrow no-underline text-muted-foreground hover:text-primary aria-[current=page]:text-primary">
                {link.label}
              </a>
            ))}
          </nav>
        )}
        {heading && title !== 'Admin' && <h1 class="mb-8 font-serif text-3xl">{title}</h1>}
        <slot />
      </Container>
    </main>
  </body>
</html>
