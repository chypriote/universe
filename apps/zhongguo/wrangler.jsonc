{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhongguo",
  "account_id": "b5799f995ae02a61a7ed04892dfb5e74",
  "compatibility_date": "2026-11-01",
  "preview_urls": false,
  // The directory is set by the Astro adapter. No not_found_handling: a path with no static file must reach the Worker (home, trips, gallery and admin render on request).
  "assets": {
    "html_handling": "drop-trailing-slash"
  },
  // Parent domain shared by every Universe app: one Owner login for all of them. Empty: this app only.
  "vars": { "OWNER_COOKIE_DOMAIN": "nicolastemeni.workers.dev" },
  // Trips, Days, Cities and Photos: the Journal reads them on each request (src/lib/journal).
  // Flight searches: the Plan page reads them on request; `npm run china` writes them through the D1 REST API (scripts/d1.js).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhongguo",
      "database_id": "24f1267a-39b4-4d29-a5bc-155504507afc",
      "migrations_dir": "migrations"
    }
  ],
  // The photo bucket: the admin writes it (docs/photos.md).
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "nico-zhongguo-photos"
    }
  ],
  // Not in this file: set them with `wrangler secret put` (see README). PHOTOS_URL is the public base URL of the photo bucket, no trailing slash.
  "secrets": {
    "required": ["PHOTOS_URL", "OWNER_PASSWORD", "JWT_SECRET"]
  }
}
