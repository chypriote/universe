{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vinyles",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "OWNER_COOKIE_DOMAIN": "nicolastemeni.workers.dev" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vinyles",
			"database_id": "cbf119c3-ce45-4671-9965-bd20b4a8b09d",
			"migrations_dir": "drizzle"
		}
	],
	"triggers": { "crons": ["0 */6 * * *"] },
	"r2_buckets": [
		{
			"binding": "COVERS",
			"bucket_name": "vinyles-covers"
		}
	]
}
