{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aviary",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "OWNER_COOKIE_DOMAIN": "nicolastemeni.workers.dev" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aviary",
			"database_id": "1ee9ff4e-d793-44b4-91c6-b62685ea8181",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "PICTURES",
			"bucket_name": "aviary"
		}
	]
	// Secrets (not in this file): OWNER_PASSWORD and JWT_SECRET. See README.
}
