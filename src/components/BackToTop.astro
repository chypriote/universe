<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="fixed bottom-4 right-4 md:bottom-8 md:right-8 z-30 hidden h-12 w-12 items-center justify-center bg-primary text-primary-foreground transition-colors hover:bg-primary-hover"
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  const button = document.getElementById('back-to-top');
  if (button) {
    const update = () => {
      const show = window.scrollY >= 600;
      button.classList.toggle("hidden", !show);
      button.classList.toggle("flex", show);
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
