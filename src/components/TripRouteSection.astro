---
import Container from '@/components/Container.astro';
import { TripRouteMap } from '@/components/islands/TripRouteMap';
import type { TripRoute } from '@/lib/itineraries.server';

interface Props {
  route: TripRoute;
}

const { route } = Astro.props;
---

{route.stops.length > 0 && (
  <section class="border-b border-border bg-surface py-20 lg:py-32">
    <Container>
      <div class="mx-auto max-w-5xl space-y-10">
        <div class="space-y-3">
          <span class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-primary">The Route</span>
          <h2 class="text-h3 font-serif italic">Cities in order</h2>
        </div>

        <div class="relative isolate z-0 aspect-[16/10] min-h-[320px] w-full overflow-hidden border border-border bg-background">
          <TripRouteMap client:visible route={route} />
        </div>

        <ol class="flex flex-wrap items-baseline gap-x-2 gap-y-2 text-sm">
          {route.stops.map((stop, index) => (
            <li class="flex items-baseline gap-2 font-sans">
              {index > 0 && (
                <span class="text-primary/50" aria-hidden="true">→</span>
              )}
              <a
                href={`#day-${stop.days[0]}`}
                class="text-foreground hover:text-primary transition-colors"
              >
                <span class="font-serif italic">{stop.name}</span>
                <span class="ml-1.5 font-sans text-[11px] text-muted-foreground" lang="zh">{stop.nameZh}</span>
                <span class="ml-1.5 text-[9px] font-bold uppercase tracking-[0.18em] text-muted-foreground">
                  {stop.dayLabel}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </Container>
  </section>
)}
