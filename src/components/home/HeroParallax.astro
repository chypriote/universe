---
import Container from '@/components/Container.astro';

interface Props {
  title?: string;
  subtitle?: string;
  image?: {
    src: string;
    srcset: string;
    alt: string;
  };
}

const { 
  title = "Wander with intent. Plan with precision.",
  subtitle = "The art of slow travel, documented and mapped.",
  image = {
    src: "https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=1200",
    srcset: "https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=480 480w, https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=768 768w, https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=1280 1280w, https://images.pexels.com/photos/15766210/pexels-photo-15766210.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w",
    alt: "Cinematic mountain landscape with mist"
  }
} = Astro.props;
---

<section class="relative h-[90vh] min-h-[600px] overflow-hidden flex items-center justify-center" data-ps="src/components/home/HeroParallax.astro:1">
  <!-- Parallax Background -->
  <div class="absolute inset-0 w-full h-[120%] -top-[10%] z-0 parallax-container" data-ps="src/components/home/HeroParallax.astro:2">
    <img 
      src={image.src}
      srcset={image.srcset}
      sizes="100vw"
      alt={image.alt}
      class="w-full h-full object-cover scale-110 grayscale-[0.1] contrast-[1.1]"
      loading="eager"
      fetchpriority="high"
      data-ps="src/components/home/HeroParallax.astro:3"
    />
    <div class="absolute inset-0 bg-dark-background/40" data-ps="src/components/home/HeroParallax.astro:4"></div>
  </div>

  <!-- Content -->
  <Container class="relative z-10 text-center text-white" data-ps="src/components/home/HeroParallax.astro:5">
    <div class="max-w-4xl mx-auto" data-ps="src/components/home/HeroParallax.astro:6">
      <span class="inline-block font-mono text-[10px] uppercase tracking-[0.4em] mb-6 reveal opacity-0" data-ps="src/components/home/HeroParallax.astro:7">A Monograph of Movement</span>
      <h1 class="text-h1 font-serif font-bold leading-tight mb-8 reveal reveal-delay-1 opacity-0" data-ps="src/components/home/HeroParallax.astro:8">
        {title}
      </h1>
      <p class="text-xl md:text-2xl font-sans text-white/80 max-w-2xl mx-auto mb-12 reveal reveal-delay-2 opacity-0" data-ps="src/components/home/HeroParallax.astro:9">
        {subtitle}
      </p>
      
      <div class="flex flex-col md:flex-row gap-4 justify-center items-center reveal reveal-delay-3 opacity-0" data-ps="src/components/home/HeroParallax.astro:10">
        <a href="/trips" class="px-10 py-4 bg-white text-dark-background font-sans font-bold uppercase tracking-widest text-xs hover:bg-white/90 transition-colors" data-ps="src/components/home/HeroParallax.astro:11">
          Explore Archive
        </a>
        <a href="/planner" class="px-10 py-4 bg-transparent border border-white/30 text-white font-sans font-bold uppercase tracking-widest text-xs hover:bg-white/10 backdrop-blur-sm transition-colors" data-ps="src/components/home/HeroParallax.astro:12">
          Route Planner
        </a>
      </div>
    </div>
  </Container>

  <!-- Bottom Gradient Fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent z-10" data-ps="src/components/home/HeroParallax.astro:13"></div>
</section>

<script>
  function initParallax() {
    const container = document.querySelector('.parallax-container') as HTMLElement;
    if (!container) return;

    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY;
      const speed = 0.35;
      container.style.transform = `translateY(${scrolled * speed}px)`;
    });
  }

  // Initialize on load
  initParallax();
</script>
