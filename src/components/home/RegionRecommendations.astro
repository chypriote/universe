---
import Container from '@/components/Container.astro';
import { ChinaMap, type ChinaMapRegion } from '@/components/islands/ChinaMap';
import { getRegionZh } from '@/lib/china-map';
import type { TripArchiveEntry } from '@/lib/itineraries.server';

interface Props {
  trips: TripArchiveEntry[];
}

const { trips } = Astro.props;

const byRegion = new Map<string, ChinaMapRegion>();
const tripCount = new Map<string, number>();
for (const trip of trips) {
  for (const name of trip.regions) {
    const count = (tripCount.get(name) ?? 0) + 1;
    tripCount.set(name, count);
    const entry = byRegion.get(name) ?? { name, zh: getRegionZh(name), href: trip.link };
    entry.photo ??= trip.photos[0];
    entry.detail = `${count} ${count === 1 ? 'trip' : 'trips'}`;
    byRegion.set(name, entry);
  }
}
const regions = [...byRegion.values()];
---

{regions.length > 0 && (
  <section id="region-recommendations" class="py-24 lg:py-32 bg-dark-background text-dark-foreground">
    <Container>
      <div class="max-w-3xl mb-16">
        <span class="eyebrow">By region</span>
        <h2 class="mt-4 text-h2 font-serif font-light">Regions</h2>
        <p class="mt-4 text-dark-muted-foreground text-lg">Every province in the journeys and plans. Each links to a trip.</p>
      </div>
      <ChinaMap client:visible tone="dark" regions={regions} idleText="Hover a region" />
    </Container>
  </section>
)}
