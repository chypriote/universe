---
import Container from '@/components/Container.astro';
import type { TripArchiveEntry } from '@/lib/itineraries.server';

interface Props {
  trips: TripArchiveEntry[];
}

const { trips } = Astro.props;

const fallbackCover =
  'https://images.pexels.com/photos/8588836/pexels-photo-8588836.jpeg';

function coverSrc(photo: string, width: number): string {
  if (photo.startsWith('https://images.pexels.com/')) {
    return `${photo}?auto=compress&cs=tinysrgb&w=${width}`;
  }
  return photo;
}

const revealDelays = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3'];
---

<section id="suggested-trips" class="py-24 lg:py-32 bg-surface border-y border-border" data-ps="src/components/home/SuggestedTrips.astro:1">
  <Container>
    <div class="flex flex-col gap-6 mb-16 reveal text-center items-center" data-ps="src/components/home/SuggestedTrips.astro:2">
      <span class="font-mono text-primary text-xs tracking-widest uppercase" data-ps="src/components/home/SuggestedTrips.astro:3">Expert Curation</span>
      <h2 class="text-h2 font-serif font-semibold text-foreground max-w-2xl" data-ps="src/components/home/SuggestedTrips.astro:4">Curated Expeditions</h2>
      <p class="text-muted-foreground text-lg max-w-2xl" data-ps="src/components/home/SuggestedTrips.astro:5">Carefully calibrated travel routes designed around optimal seasons and logical flight connections.</p>
    </div>

    {trips.length === 0 ? (
      <p class="text-center text-muted-foreground font-serif italic">No upcoming expeditions yet.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12" data-ps="src/components/home/SuggestedTrips.astro:6">
        {trips.map((trip, index) => {
          const cover = trip.photos[0] ?? fallbackCover;

          return (
            <article class={`flex flex-col reveal ${revealDelays[index] ?? ''}`} data-ps={`src/components/home/SuggestedTrips.astro:${trip.id}`}>
              <div class="relative aspect-[3/4] overflow-hidden border border-border mb-6">
                <img
                  src={coverSrc(cover, 1200)}
                  srcset={`${coverSrc(cover, 320)} 320w, ${coverSrc(cover, 480)} 480w, ${coverSrc(cover, 640)} 640w, ${coverSrc(cover, 768)} 768w, ${coverSrc(cover, 1024)} 1024w`}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  alt={trip.title}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col gap-3">
                <div class="flex justify-between items-center">
                  <span class="font-mono text-[10px] text-muted-foreground uppercase tracking-widest">
                    {trip.durationDays} Days // {trip.destination}
                  </span>
                  <span class="font-mono text-primary text-xs font-medium">{trip.dates}</span>
                </div>
                <h3 class="text-xl font-serif font-semibold text-foreground">{trip.title}</h3>
                <p class="text-sm text-muted-foreground line-clamp-2">{trip.description}</p>
                <a href={trip.link} class="text-[10px] font-sans font-bold uppercase tracking-widest text-foreground hover:text-primary transition-colors underline decoration-primary/30 underline-offset-4">
                  View Curated Itinerary
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </Container>
</section>
