---
import Container from '@/components/Container.astro';
---

<section class="bg-background pt-8 pb-20 lg:pb-32" data-ps="src/components/home/HeroSplit.astro:1">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-stretch" data-ps="src/components/home/HeroSplit.astro:2">
      <!-- Left: Planning & Editorial -->
      <div class="lg:col-span-7 flex flex-col justify-center" data-ps="src/components/home/HeroSplit.astro:3">
        <span class="font-mono text-primary text-xs tracking-[0.2em] uppercase mb-6 reveal" data-ps="src/components/home/HeroSplit.astro:4">Est. MMXXIV</span>
        <h1 class="text-h1 font-serif font-semibold text-foreground leading-[1.1] mb-8 reveal reveal-delay-1" data-ps="src/components/home/HeroSplit.astro:5">
          Wander with intent.<br/>Plan with precision.
        </h1>
        
        <!-- Minimal Route Search -->
        <div class="bg-surface border border-border p-8 reveal reveal-delay-2" data-ps="src/components/home/HeroSplit.astro:6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8" data-ps="src/components/home/HeroSplit.astro:7">
            <div class="flex flex-col gap-2" data-ps="src/components/home/HeroSplit.astro:8">
              <label class="text-[10px] uppercase tracking-widest text-muted-foreground font-mono" data-ps="src/components/home/HeroSplit.astro:9">Departure</label>
              <input type="text" placeholder="Origin city" class="bg-transparent border-b border-border py-2 text-foreground focus:outline-none focus:border-primary transition-colors font-sans" data-ps="src/components/home/HeroSplit.astro:10" />
            </div>
            <div class="flex flex-col gap-2" data-ps="src/components/home/HeroSplit.astro:11">
              <label class="text-[10px] uppercase tracking-widest text-muted-foreground font-mono" data-ps="src/components/home/HeroSplit.astro:12">Arrival</label>
              <input type="text" placeholder="Destination" class="bg-transparent border-b border-border py-2 text-foreground focus:outline-none focus:border-primary transition-colors font-sans" data-ps="src/components/home/HeroSplit.astro:13" />
            </div>
            <div class="flex flex-col gap-2" data-ps="src/components/home/HeroSplit.astro:14">
              <label class="text-[10px] uppercase tracking-widest text-muted-foreground font-mono" data-ps="src/components/home/HeroSplit.astro:15">Window</label>
              <select class="bg-transparent border-b border-border py-2 text-foreground focus:outline-none focus:border-primary transition-colors font-sans appearance-none" data-ps="src/components/home/HeroSplit.astro:16">
                <option data-ps="src/components/home/HeroSplit.astro:17">September 2024</option>
                <option data-ps="src/components/home/HeroSplit.astro:18">October 2024</option>
                <option data-ps="src/components/home/HeroSplit.astro:19">November 2024</option>
              </select>
            </div>
          </div>
          <a href="/planning" class="inline-block w-full md:w-auto px-10 py-4 bg-primary text-primary-foreground font-sans font-bold uppercase tracking-widest text-xs hover:bg-primary-hover transition-colors text-center" data-ps="src/components/home/HeroSplit.astro:20">
            Launch Route Planner
          </a>
        </div>
      </div>

      <!-- Right: Immersive Portrait -->
      <div class="lg:col-span-5 relative" data-ps="src/components/home/HeroSplit.astro:21">
        <div class="relative aspect-[4/5] lg:aspect-auto lg:h-full overflow-hidden reveal reveal-delay-3" data-ps="src/components/home/HeroSplit.astro:22">
          <img 
            src="https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=1200" 
            srcset="https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=480 480w, https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=768 768w, https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=1280 1280w, https://images.pexels.com/photos/8991518/pexels-photo-8991518.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w"
            sizes="(max-width: 1024px) 100vw, 40vw"
            alt="Remote misty mountain peak in Japan" 
            class="w-full h-full object-cover grayscale-[0.2] sepia-[0.1]"
            loading="eager"
            fetchpriority="high"
            data-ps="src/components/home/HeroSplit.astro:23"
          />
        </div>
        <!-- Caption for visual interest -->
        <div class="absolute bottom-6 left-6 right-6 lg:left-auto lg:-left-12 lg:bottom-12 lg:max-w-xs bg-background/90 backdrop-blur-md p-6 border border-border reveal reveal-delay-4" data-ps="src/components/home/HeroSplit.astro:24">
          <p class="font-serif italic text-foreground text-lg" data-ps="src/components/home/HeroSplit.astro:25">"The climb is silent, the peak is mist. Somewhere above the tree line, time simply stops."</p>
          <span class="block mt-4 font-mono text-[10px] text-muted-foreground uppercase tracking-widest" data-ps="src/components/home/HeroSplit.astro:26">Region 08 // Northern Alps, Japan</span>
        </div>
      </div>
    </div>
  </Container>
</section>
