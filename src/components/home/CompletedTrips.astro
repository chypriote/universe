---
import Container from '@/components/Container.astro';
import type { TripArchiveEntry } from '@/lib/itineraries.server';

interface Props {
  trips: TripArchiveEntry[];
}

const { trips } = Astro.props;
---

<section id="completed-trips" class="py-24 lg:py-32 bg-background" data-ps="src/components/home/CompletedTrips.astro:1">
  <Container>
    <div class="flex flex-col gap-6 mb-16 reveal" data-ps="src/components/home/CompletedTrips.astro:2">
      <span class="font-mono text-primary text-xs tracking-widest uppercase" data-ps="src/components/home/CompletedTrips.astro:3">Field Reports</span>
      <h2 class="text-h2 font-serif font-semibold text-foreground max-w-2xl" data-ps="src/components/home/CompletedTrips.astro:4">Recent Journeys</h2>
      <p class="text-muted-foreground text-lg max-w-xl" data-ps="src/components/home/CompletedTrips.astro:5">Deep-dive photo journals and slow travel logs from the field.</p>
    </div>

    <div class="flex flex-col gap-24 lg:gap-32" data-ps="src/components/home/CompletedTrips.astro:6">
      {trips.map((trip, index) => {
        const imageLeft = index % 2 === 0;
        const cover = trip.photos[0];
        const regionLabel = trip.regions.join(' · ');

        return (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps={`src/components/home/CompletedTrips.astro:entry-${trip.id}`}>
            {cover && (
              <div class={`lg:col-span-7 ${imageLeft ? 'reveal reveal-left' : 'order-1 lg:order-2 reveal reveal-right'}`}>
                <div class="relative aspect-[16/9] overflow-hidden">
                  <img
                    src={cover}
                    alt={trip.title}
                    class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                    loading="lazy"
                  />
                </div>
              </div>
            )}
            <div class={`lg:col-span-5 flex flex-col gap-6 ${imageLeft ? 'reveal reveal-right reveal-delay-1' : 'order-2 lg:order-1 reveal reveal-left reveal-delay-1'}`}>
              <div class="font-mono text-[10px] text-muted-foreground uppercase tracking-widest">
                <span>{trip.dates}</span>
              </div>
              <h3 class="text-3xl font-serif font-semibold text-foreground">
                <a href={trip.link}>{trip.title}</a>
              </h3>
              <p class="text-muted-foreground leading-relaxed">
                {trip.description}
              </p>
              {regionLabel && (
                <div class="font-mono text-[10px] text-muted-foreground uppercase tracking-widest">
                  {regionLabel}
                </div>
              )}
              <a href={trip.link} class="group flex items-center gap-2 text-primary font-sans font-bold uppercase tracking-widest text-xs">
                Read Journal Entry
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</section>
