---
import Container from '@/components/Container.astro';
---

<section id="completed-trips" class="py-24 lg:py-32 bg-background" data-ps="src/components/home/CompletedTrips.astro:1">
  <Container>
    <div class="flex flex-col gap-6 mb-16 reveal" data-ps="src/components/home/CompletedTrips.astro:2">
      <span class="font-mono text-primary text-xs tracking-widest uppercase" data-ps="src/components/home/CompletedTrips.astro:3">Field Reports</span>
      <h2 class="text-h2 font-serif font-semibold text-foreground max-w-2xl" data-ps="src/components/home/CompletedTrips.astro:4">Recent Journeys</h2>
      <p class="text-muted-foreground text-lg max-w-xl" data-ps="src/components/home/CompletedTrips.astro:5">Deep-dive photo journals and slow travel logs from the field.</p>
    </div>

    <div class="flex flex-col gap-24 lg:gap-32" data-ps="src/components/home/CompletedTrips.astro:6">
      <!-- Entry 1 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps="src/components/home/CompletedTrips.astro:7">
        <div class="lg:col-span-7 reveal reveal-left" data-ps="src/components/home/CompletedTrips.astro:8">
          <div class="relative aspect-[16/9] overflow-hidden" data-ps="src/components/home/CompletedTrips.astro:9">
            <img 
              src="https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=1200" 
              srcset="https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=480 480w, https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=768 768w, https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=1280 1280w, https://images.pexels.com/photos/37735406/pexels-photo-37735406.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w"
              sizes="(max-width: 1024px) 100vw, 60vw"
              alt="Kyoto moss temple garden path" 
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
              data-ps="src/components/home/CompletedTrips.astro:10"
            />
          </div>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-6 reveal reveal-right reveal-delay-1" data-ps="src/components/home/CompletedTrips.astro:11">
          <div class="flex items-center gap-4 font-mono text-[10px] text-muted-foreground uppercase tracking-widest" data-ps="src/components/home/CompletedTrips.astro:12">
            <span data-ps="src/components/home/CompletedTrips.astro:13">April 2024</span>
            <span class="w-1 h-1 bg-border rounded-full" data-ps="src/components/home/CompletedTrips.astro:14"></span>
            <span data-ps="src/components/home/CompletedTrips.astro:15">35.0116° N, 135.7681° E</span>
          </div>
          <h3 class="text-3xl font-serif font-semibold text-foreground" data-ps="src/components/home/CompletedTrips.astro:16">Kyoto's Hidden Temple Paths</h3>
          <p class="text-muted-foreground leading-relaxed" data-ps="src/components/home/CompletedTrips.astro:17">
            Following the linen-bleached edges of the city, we discovered moss gardens that have stood silent for centuries. A study in green, patience, and the art of the slow walk.
          </p>
          <a href="/trips/kyoto" class="group flex items-center gap-2 text-primary font-sans font-bold uppercase tracking-widest text-xs" data-ps="src/components/home/CompletedTrips.astro:18">
            Read Journal Entry
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-ps="src/components/home/CompletedTrips.astro:19">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Entry 2 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps="src/components/home/CompletedTrips.astro:20">
        <div class="lg:col-span-5 order-2 lg:order-1 flex flex-col gap-6 reveal reveal-left reveal-delay-1" data-ps="src/components/home/CompletedTrips.astro:21">
          <div class="flex items-center gap-4 font-mono text-[10px] text-muted-foreground uppercase tracking-widest" data-ps="src/components/home/CompletedTrips.astro:22">
            <span data-ps="src/components/home/CompletedTrips.astro:23">May 2024</span>
            <span class="w-1 h-1 bg-border rounded-full" data-ps="src/components/home/CompletedTrips.astro:24"></span>
            <span data-ps="src/components/home/CompletedTrips.astro:25">45.9389° N, 123.9615° W</span>
          </div>
          <h3 class="text-3xl font-serif font-semibold text-foreground" data-ps="src/components/home/CompletedTrips.astro:26">Seven Days Along the Oregon Coastline</h3>
          <p class="text-muted-foreground leading-relaxed" data-ps="src/components/home/CompletedTrips.astro:27">
            Misty mornings and moody sea stacks. We mapped the rugged Pacific edge where the forest meets the salt spray, tracing routes through fog-drenched headlands.
          </p>
          <a href="/trips/oregon" class="group flex items-center gap-2 text-primary font-sans font-bold uppercase tracking-widest text-xs" data-ps="src/components/home/CompletedTrips.astro:28">
            Read Journal Entry
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-ps="src/components/home/CompletedTrips.astro:29">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="lg:col-span-7 order-1 lg:order-2 reveal reveal-right" data-ps="src/components/home/CompletedTrips.astro:30">
          <div class="relative aspect-[16/9] overflow-hidden" data-ps="src/components/home/CompletedTrips.astro:31">
            <img 
              src="https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=1200" 
              srcset="https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=480 480w, https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=768 768w, https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=1280 1280w, https://images.pexels.com/photos/21940152/pexels-photo-21940152.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w"
              sizes="(max-width: 1024px) 100vw, 60vw"
              alt="Oregon coastline sea stacks" 
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
              data-ps="src/components/home/CompletedTrips.astro:32"
            />
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
