---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = "Travel Guides — SOJOURN Handbook";
const description = "Practical, structured resources for the modern explorer. From essential digital tools to complex visa navigation.";

const guides = [
  {
    title: "Essential Apps",
    description: "The digital tools and local messaging standards you need before arrival.",
    href: "/guides/essential-apps",
    image: "https://images.pexels.com/photos/5444625/pexels-photo-5444625.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  {
    title: "Visa & Entry",
    description: "Navigating international borders, ETAs, and passport requirements.",
    href: "/guides/visa-entry",
    image: "https://images.pexels.com/photos/19671961/pexels-photo-19671961.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  {
    title: "Payment Setup",
    description: "Digital wallets, physical cards, and pre-arrival financial readiness.",
    href: "/guides/payment-setup",
    image: "https://images.pexels.com/photos/10330114/pexels-photo-10330114.jpeg?auto=compress&cs=tinysrgb&w=800"
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": `${SITE.url}/guides`
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="py-20 lg:py-32 border-b border-border" data-ps="src/pages/guides/index.astro:i6jlax">
    <Container>
      <div class="max-w-3xl" data-ps="src/pages/guides/index.astro:j5tkvi">
        <span class="inline-block text-primary font-sans font-bold text-xs uppercase tracking-[0.3em] mb-4" data-ps="src/pages/guides/index.astro:vi2wy7">The Handbook</span>
        <h1 class="text-h1 font-serif mb-6" data-ps="src/pages/guides/index.astro:fd1dzp">Travel Guides</h1>
        <p class="text-muted-foreground text-lg md:text-xl font-sans leading-relaxed" data-ps="src/pages/guides/index.astro:xebobd">
          A collection of tactical resources designed to remove friction from your journey. Prepared by explorers, for explorers.
        </p>
      </div>
    </Container>
  </section>

  <!-- Guides Grid -->
  <section class="py-20 lg:py-32 bg-surface/30" data-ps="src/pages/guides/index.astro:i6jlaw">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12" data-ps="src/pages/guides/index.astro:j5tkvh">
        {guides.map((guide, __psIdx) => (
          <a href={guide.href} class="group flex flex-col" data-ps={`src/pages/guides/index.astro:uiugy1-${__psIdx}`}>
            <div class="aspect-[4/5] overflow-hidden border border-border mb-6" data-ps={`src/pages/guides/index.astro:j5tkvg-${__psIdx}`}>
              <img 
                src={guide.image} 
                alt={guide.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" data-ps={`src/pages/guides/index.astro:m01iga-${__psIdx}`} />
            </div>
            <h2 class="text-2xl font-serif mb-3 group-hover:text-primary transition-colors" data-ps={`src/pages/guides/index.astro:evzqur-${__psIdx}`}>{guide.title}</h2>
            <p class="text-muted-foreground text-sm leading-relaxed mb-6 flex-grow" data-ps={`src/pages/guides/index.astro:xebobe-${__psIdx}`}>{guide.description}</p>
            <span class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] border-b border-primary w-fit pb-1 group-hover:border-primary-hover transition-colors" data-ps={`src/pages/guides/index.astro:vi2wy6-${__psIdx}`}>
              Read Guide
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Global Prep CTA -->
  <section class="py-20 border-t border-border" data-ps="src/pages/guides/index.astro:i6jlav">
    <Container class="text-center">
      <h2 class="text-h2 font-serif mb-6" data-ps="src/pages/guides/index.astro:evzqus">Ready to plan your route?</h2>
      <p class="text-muted-foreground max-w-xl mx-auto mb-10" data-ps="src/pages/guides/index.astro:xebobf">
        Once you've settled the basics, use our atmospheric flight planner to visualize your technical logistics.
      </p>
      <a href="/planner" class="inline-block px-10 py-4 bg-dark text-dark-foreground font-sans font-bold text-xs uppercase tracking-[0.3em] hover:bg-primary transition-colors" data-ps="src/pages/guides/index.astro:uiugy0">
        Open Flight Planner
      </a>
    </Container>
  </section>
</BaseLayout>
