---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = "Visa & Entry Information — Travel Guide";
const description = "Navigating international borders, ETAs, and passport requirements for the modern explorer.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": `${SITE.url}/guides/visa-entry`
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="py-20 lg:py-32">
    <Container>
      <div class="max-w-3xl mx-auto">
        <nav class="mb-12">
          <a href="/guides" class="eyebrow text-muted-foreground hover:text-primary transition-colors">
            ← All guides
          </a>
        </nav>

        <header class="mb-16">
          <span class="eyebrow mb-4 inline-block">Chapter 02</span>
          <h1 class="text-h1 font-serif font-light mb-8">Visa & Entry Information</h1>
          <p class="text-xl text-muted-foreground leading-relaxed">
            Navigating international borders requires meticulous attention to current regulations. Entry requirements can change with little notice based on diplomatic shifts or public health policies.
          </p>
        </header>

        <div class="prose prose-lg max-w-none">

          <div class="my-16 p-8 bg-dark text-dark-foreground">
            <h4 class="text-dark-foreground font-serif text-2xl mb-6">Preparation Checklist</h4>
            <ul class="space-y-6 m-0 p-0 list-none">
              <li class="flex gap-6 border-b border-dark-border pb-6">
                <span class="font-serif text-2xl font-light text-primary">01</span>
                <div>
                  <strong class="block text-sm uppercase tracking-wider mb-2">Validity Check</strong>
                  <p class="text-sm text-dark-muted-foreground m-0 leading-relaxed">Ensure your passport is valid for at least 6 months beyond your intended date of departure. Many airlines will deny boarding at the terminal if this threshold is not met.</p>
                </div>
              </li>
              <li class="flex gap-6 border-b border-dark-border pb-6">
                <span class="font-serif text-2xl font-light text-primary">02</span>
                <div>
                  <strong class="block text-sm uppercase tracking-wider mb-2">Electronic Authorization</strong>
                  <p class="text-sm text-dark-muted-foreground m-0 leading-relaxed">Apply for ETAs or e-Visas at least 14 days before departure. While some are instant, technical glitches or manual reviews can cause processing delays.</p>
                </div>
              </li>
              <li class="flex gap-6">
                <span class="font-serif text-2xl font-light text-primary">03</span>
                <div>
                  <strong class="block text-sm uppercase tracking-wider mb-2">Proof of Onward Travel</strong>
                  <p class="text-sm text-dark-muted-foreground m-0 leading-relaxed">Immigration officers frequently request your return flight details and initial lodging confirmation. Keep both digital and physical copies accessible.</p>
                </div>
              </li>
            </ul>
          </div>

          <h2 class="font-serif text-3xl mt-16 mb-8">Transit & Visa-Free Entry</h2>
          <p>Many regions offer transit-without-visa (TWOV) programs if you are remaining in the airport or transiting within a specific time window—usually 24–72 hours. Always verify if these require a specific arrival or departure terminal before booking multi-leg itineraries.</p>
        </div>

        <footer class="mt-20 pt-20 border-t border-border flex justify-between items-center">
          <div class="flex flex-col">
            <span class="eyebrow text-muted-foreground mb-2">Previous</span>
            <a href="/guides/essential-apps" class="text-lg font-serif hover:text-primary transition-colors">← Essential Apps</a>
          </div>
          <div class="flex flex-col text-right">
            <span class="eyebrow text-muted-foreground mb-2">Next</span>
            <a href="/guides/payment-setup" class="text-lg font-serif hover:text-primary transition-colors">Payment Setup →</a>
          </div>
        </footer>
      </div>
    </Container>
  </article>
</BaseLayout>
