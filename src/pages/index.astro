---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroParallax from '@/components/home/HeroParallax.astro';
import CompletedTrips from '@/components/home/CompletedTrips.astro';
import SuggestedTrips from '@/components/home/SuggestedTrips.astro';
import RegionRecommendations from '@/components/home/RegionRecommendations.astro';
import { getCollection } from 'astro:content';
import { buildTripArchiveEntry, isPublishedItinerary } from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const completedTrips = itineraries
  .filter(isPublishedItinerary)
  .sort(
    (a, b) =>
      b.data.released_itinerary.start_date.localeCompare(
        a.data.released_itinerary.start_date,
      ),
  )
  .map(buildTripArchiveEntry)
  .filter((trip) => trip.type === 'report');
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <HeroParallax />
  <CompletedTrips trips={completedTrips} />
  <SuggestedTrips />
  <RegionRecommendations />
</BaseLayout>
