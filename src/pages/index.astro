---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import CompletedTrips from '@/components/home/CompletedTrips.astro';
import SuggestedTrips from '@/components/home/SuggestedTrips.astro';
import RegionRecommendations from '@/components/home/RegionRecommendations.astro';
import { getCollection } from 'astro:content';
import { buildTripArchiveEntry, isPublishedItinerary } from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const publishedTrips = await Promise.all(
  itineraries
    .filter(isPublishedItinerary)
    .sort(
      (a, b) =>
        (b.data.released_itinerary.start_date ?? '').localeCompare(
          a.data.released_itinerary.start_date ?? '',
        ),
    )
    .map(buildTripArchiveEntry),
);
const completedTrips = publishedTrips.filter((trip) => trip.type === 'report');
const suggestedTrips = publishedTrips.filter((trip) => trip.type === 'plan');
const heroTrip = completedTrips.find((trip) => trip.photos[0]);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <Hero image={heroTrip?.photos[0]} imageAlt={heroTrip?.title} />
  <CompletedTrips trips={completedTrips} />
  <SuggestedTrips trips={suggestedTrips} />
  <RegionRecommendations trips={publishedTrips} />
</BaseLayout>
