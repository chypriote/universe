const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "SOJOURN Photography Archive",
  "description": "A curated collection of travel photography across global expeditions.",
  "url": "https://example.com/gallery"
};
---

<BaseLayout title="Photography — SOJOURN" description="Explore our curated collection of travel photography across global expeditions." jsonLd={jsonLd}>
  <main class="py-24 lg:py-32" data-ps="src/pages/gallery.astro:3b6zx">
    <Container>
      <div class="max-w-3xl mb-20 lg:mb-32" data-ps="src/pages/gallery.astro:5r9mu2">
        <h1 class="text-h1 font-serif mb-8" data-ps="src/pages/gallery.astro:rpwpws">Photography</h1>
        <p class="text-xl text-muted-foreground font-sans leading-relaxed" data-ps="src/pages/gallery.astro:befxb1">
          Our photographic archive is more than a collection of images—it is a visual monograph of the places that shaped our perspective. Organized by journey, these chapters represent the intersection of time, light, and geography.
        </p>
      </div>

      <div class="space-y-32" data-ps="src/pages/gallery.astro:5r9mu1">
        <GalleryGrid 
          client:load 
          title="Neon Nights & Zen Gardens" 
          tags={["Tokyo", "Kyoto", "Japan"]} 
          photos={japanPhotos} 
        />
        
        <GalleryGrid 
          client:load 
          title="The Amalfi Monographs" 
          tags={["Positano", "Amalfi Coast", "Italy"]} 
          photos={italyPhotos} 
        />

        <GalleryGrid 
          client:load 
          title="Ochre & Dust" 
          tags={["Marrakech", "Sahara", "Morocco"]} 
          photos={moroccoPhotos} 
        />

        <GalleryGrid 
          client:load 
          title="Fire & Ice" 
          tags={["Skogafoss", "Reykjavik", "Iceland"]} 
          photos={icelandPhotos} 
        />
      </div>

      <div class="mt-32 pt-20 border-t border-border text-center" data-ps="src/pages/gallery.astro:5r9mu0">
        <h3 class="text-2xl font-serif mb-6" data-ps="src/pages/gallery.astro:qrtfmz">Want to see more?</h3>
        <p class="text-muted-foreground mb-10 max-w-lg mx-auto" data-ps="src/pages/gallery.astro:befxb0">
          Our full archive is available for editorial licensing and private prints. Contact our studio for inquiries.
        </p>
        <a href="/trips" class="inline-block px-10 py-4 bg-primary text-primary-foreground font-sans font-bold text-xs uppercase tracking-[0.2em] hover:bg-primary-hover transition-colors" data-ps="src/pages/gallery.astro:b66pa8">
          View Destination Journals
        </a>
      </div>
    </Container>
  </main>
</BaseLayout>
