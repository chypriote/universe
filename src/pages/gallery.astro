    alt: "Tokyo street at night",
    photographer: "G N"
  },
  {
    url: "https://images.pexels.com/photos/30641513/pexels-photo-30641513.jpeg?auto=compress&cs=tinysrgb&w=1200",
    srcset: "https://images.pexels.com/photos/30641513/pexels-photo-30641513.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/30641513/pexels-photo-30641513.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/30641513/pexels-photo-30641513.jpeg?auto=compress&cs=tinysrgb&w=1200 1200w",
    alt: "Neon lights in Tokyo",
