---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { GalleryGrid } from '@/components/islands/GalleryGrid';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import {
  getAllTripPhotoMetadata,
  isPublishedItinerary,
} from '@/lib/itineraries.server';

const itineraries = await getCollection('itineraries');
const gallerySections = itineraries
  .filter(isPublishedItinerary)
  .sort(
    (a, b) =>
      b.data.released_itinerary.start_date.localeCompare(
        a.data.released_itinerary.start_date,
      ),
  )
  .map((entry) => {
    const { data } = entry;
    const cities = [...new Set(data.days.map((day) => day.main_city))];
    const regions = [...new Set(data.cities.map((city) => city.region))];
    const tags = [...new Set([...regions, ...cities])].slice(0, 4);

    const photos = getAllTripPhotoMetadata(data.slug).map((image, index) => ({
      url: image.src,
      srcset: `${image.src} ${image.width}w`,
      alt: `${data.title} — photo ${index + 1}`,
      photographer: 'Nico',
    }));

    return {
      id: data.slug,
      title: data.title,
      tags,
      photos,
    };
  })
  .filter((section) => section.photos.length > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": `Photography Archive — ${SITE.name}`,
  "description": "A curated collection of travel photography across China expeditions.",
  "url": `${SITE.url}/gallery`
};
---

<BaseLayout title="Photography" description="Explore our curated collection of travel photography across China expeditions." jsonLd={jsonLd}>
  <main class="py-24 lg:py-32" data-ps="src/pages/gallery.astro:3b6zx">
    <Container>
      <div class="max-w-3xl mb-20 lg:mb-32" data-ps="src/pages/gallery.astro:5r9mu2">
        <h1 class="text-h1 font-serif mb-8" data-ps="src/pages/gallery.astro:rpwpws">Photography</h1>
        <p class="text-xl text-muted-foreground font-sans leading-relaxed" data-ps="src/pages/gallery.astro:befxb1">
          Our photographic archive is more than a collection of images—it is a visual monograph of the places that shaped our perspective. Organized by journey, these chapters represent the intersection of time, light, and geography.
        </p>
      </div>

      <div class="space-y-32" data-ps="src/pages/gallery.astro:5r9mu1">
        {gallerySections.map((section) => (
          <GalleryGrid
            client:load
            title={section.title}
            tags={section.tags}
            photos={section.photos}
          />
        ))}
      </div>

      <div class="mt-32 pt-20 border-t border-border text-center" data-ps="src/pages/gallery.astro:5r9mu0">
        <h3 class="text-2xl font-serif mb-6" data-ps="src/pages/gallery.astro:qrtfmz">Want to see more?</h3>
        <p class="text-muted-foreground mb-10 max-w-lg mx-auto" data-ps="src/pages/gallery.astro:befxb0">
          Each journey has its own day-by-day monograph with notes, routes, and galleries.
        </p>
        <a href="/trips" class="inline-block px-10 py-4 bg-primary text-primary-foreground font-sans font-bold text-xs uppercase tracking-[0.2em] hover:bg-primary-hover transition-colors" data-ps="src/pages/gallery.astro:b66pa8">
          View Destination Journals
        </a>
      </div>
    </Container>
  </main>
</BaseLayout>
