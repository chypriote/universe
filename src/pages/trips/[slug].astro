---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import TripRouteSection from '@/components/TripRouteSection.astro';
import { TripDayGallery } from '@/components/islands/TripDayGallery';
import { PlanCalendar } from '@/components/islands/PlanCalendar';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import {
  buildTripArchiveEntry,
  buildTripPage,
  isPublishedItinerary,
} from '@/lib/itineraries.server';

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries');

  return Promise.all(
    itineraries.filter(isPublishedItinerary).map(async (entry) => ({
      params: { slug: entry.data.slug },
      props: { trip: await buildTripPage(entry) },
    })),
  );
}

const { trip } = Astro.props;
const { slug } = Astro.params;

const otherTrips = (
  await Promise.all(
    (await getCollection('itineraries'))
      .filter(isPublishedItinerary)
      .filter((entry) => entry.data.slug !== slug)
      .map(buildTripArchiveEntry),
  )
)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TravelAction",
  "name": trip.title,
  "description": trip.description,
  "url": `${SITE.url}/trips/${slug}`,
  "location": {
    "@type": "Place",
    "name": trip.destination
  }
};
---

<BaseLayout title={trip.title} description={trip.description} jsonLd={jsonLd}>
  <article class="bg-background">
    <header class="pt-20 pb-16 lg:pt-28 lg:pb-24 border-b border-border">
      <Container>
        <div class="flex flex-wrap items-center gap-4 animate-fade-in">
          <span class="eyebrow">{trip.destination}</span>
          <span class="w-10 h-px bg-border"></span>
          <span class="eyebrow text-muted-foreground">{trip.dates}</span>
        </div>
        <h1 class="mt-6 max-w-4xl text-h1 font-serif font-light animate-fade-in">{trip.title}</h1>

        <div class="mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
          <p class="lg:col-span-5 text-xl font-serif font-light leading-relaxed text-foreground/80">
            {trip.description}
          </p>
          <div class="lg:col-span-7">
            <span class="eyebrow text-muted-foreground">Cities</span>
            <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-6 gap-y-4 border-t border-border pt-4">
              {trip.cities.map((city) => (
                <li>
                  <p class="font-serif text-lg leading-tight">{city.name}</p>
                  <p class="text-xs text-muted-foreground">
                    <span lang="zh">{city.nameZh}</span>
                    <span class="ml-1.5">{city.pinyin}</span>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </Container>
    </header>

    <TripRouteSection route={trip.route} />

    {/* Day-by-Day Journey */}
    <div class="py-20 lg:py-32">
      <Container>
        <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_12rem] xl:gap-12">
        <div class="max-w-5xl mx-auto w-full space-y-24 lg:space-y-40">
          {trip.days.map((day, __psIdx) => (
            <section class="scroll-mt-32" id={`day-${day.day}`}>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
                {/* Day Marker & Meta (Sticky-ish) */}
                <div class="lg:col-span-3 lg:sticky lg:top-32 h-fit space-y-6">
                  <div class="space-y-2">
                    <span class="block font-serif text-6xl font-light leading-none text-primary">{String(day.day).padStart(2, '0')}</span>
                    <span class="eyebrow text-muted-foreground">Day {day.day}</span>
                    <h2 class="text-h3 font-serif">{day.title}</h2>
                  </div>
                  
                  <div class="pt-6 border-t border-border space-y-8">
                    {day.activities.length > 0 && (
                      <div class="space-y-3">
                        <span class="eyebrow text-muted-foreground">Activities</span>
                        <ul class="space-y-2">
                          {day.activities.map(activity => (
                            <li class="text-sm text-muted-foreground flex items-start gap-2">
                              <span class="mt-2 w-1 h-1 bg-primary shrink-0"></span>
                              <span class="space-y-0.5">
                                <span class="block text-foreground">{activity.name}</span>
                                <span class="block text-xs leading-snug">
                                  <span lang="zh">{activity.nameZh}</span>
                                  <span class="ml-1.5">{activity.pinyin}</span>
                                </span>
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {day.food.length > 0 && (
                      <div class="space-y-3">
                        <span class="eyebrow text-muted-foreground">Food</span>
                        <ul class="space-y-2">
                          {day.food.map(item => (
                            <li class="text-sm font-serif italic text-foreground/80">{item}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>

                {/* Narrative & Gallery */}
                <div class="lg:col-span-9 space-y-12">
                  <div class="max-w-2xl text-lg leading-relaxed text-foreground/85">
                    <p>{day.description}</p>
                  </div>

                  {day.gallery.length > 0 && (
                    <TripDayGallery client:visible photos={day.gallery} day={day.day} tripTitle={trip.title} />
                  )}
                </div>
              </div>
            </section>
          ))}
        </div>

        {trip.days.length > 1 && (
          <aside class="hidden xl:block">
            <nav class="sticky top-28" aria-label="Days" data-day-nav>
              <span class="eyebrow text-muted-foreground">Days</span>
              <ol class="mt-4 border-t border-border">
                {trip.days.map((day) => (
                  <li class="border-b border-border">
                    <a
                      href={`#day-${day.day}`}
                      class="flex gap-3 py-3 text-sm text-muted-foreground hover:text-primary transition-colors aria-[current=true]:text-primary"
                    >
                      <span class="font-serif tabular-nums">{String(day.day).padStart(2, '0')}</span>
                      <span class="line-clamp-2">{day.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
        </div>
      </Container>
    </div>

    {trip.planDays.length > 0 && (
      <section id="calendar" class="border-t border-border py-20 lg:py-32">
        <Container>
          <PlanCalendar client:load days={trip.planDays} startDate={trip.startDate} />
        </Container>
      </section>
    )}

    {/* Other Journeys */}
    <section class="border-t border-border py-20 lg:py-28 bg-surface">
      <Container>
        {otherTrips.length > 0 && (
          <div class="space-y-12 mb-20 lg:mb-28">
            <div class="text-center space-y-3">
              <span class="eyebrow">Keep reading</span>
              <h2 class="text-h2 font-serif font-light">Other journeys</h2>
            </div>

            <div class={`grid gap-10 lg:gap-16 ${otherTrips.length === 1 ? 'max-w-xl mx-auto' : otherTrips.length === 2 ? 'md:grid-cols-2 max-w-4xl mx-auto' : 'md:grid-cols-3'}`}>
              {otherTrips.map((other) => (
                <a href={other.link} class="group block space-y-4">
                  {other.photos[0] && (
                    <div class="relative overflow-hidden aspect-[4/3] bg-background">
                      <img
                        src={other.photos[0]}
                        alt={other.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="space-y-2">
                    <span class="eyebrow text-muted-foreground">
                      {other.dates}
                    </span>
                    <h3 class="text-2xl font-serif group-hover:text-primary transition-colors">
                      {other.title}
                    </h3>
                    <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                      {other.description}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="flex justify-center">
          <a
            href="/trips"
            class="btn btn-outline"
          >
            All journeys
          </a>
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>

<script>
  const nav = document.querySelector('[data-day-nav]');
  if (nav) {
    const links = new Map(
      [...nav.querySelectorAll('a')].map((a) => [a.getAttribute('href')!.slice(1), a]),
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a, id) =>
            a.setAttribute('aria-current', String(id === entry.target.id)),
          );
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }
</script>
